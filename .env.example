# Formulier en e-mail (Resend). Kopieer dit bestand naar `.env` voor lokaal gebruik; zet dezelfde drie variabelen in Vercel
# (Settings > Environment Variables) voor Production én Preview. Zie README, "Formulier en e-mail (Resend)".

# API-sleutel uit het Resend-dashboard. Leeg laten voor de dev-modus: `npm run dev` verstuurt dan niets en logt de
# aanvraag in de terminal (dry-run). In productie en preview geeft het formulier zonder sleutel een 503.
RESEND_API_KEY=

# Ontvanger van de aanvragen (Paul). Laat leeg om het adres uit src/data/site.ts (CONTACT.email) te gebruiken.
FORM_TO_EMAIL=

# Afzender van beide mails. Het domein moet in Resend geverifieerd zijn (SPF en DKIM), bijvoorbeeld:
# FORM_FROM_EMAIL="Paul Breuker <aanvraag@paulbreuker.nl>"
FORM_FROM_EMAIL=
