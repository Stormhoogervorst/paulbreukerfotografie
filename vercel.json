{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/promoties",
      "destination": "https://www.fotograafpromotiesradboud.nl/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "view", "value": { "eq": "article" } },
        { "type": "query", "key": "id", "value": { "re": "^141(:|%3A)curriculum-vitae$" } }
      ],
      "destination": "/over-paul",
      "permanent": true
    }
  ]
}
