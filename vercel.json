{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "paulbreukerfotografie.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/promoties",
      "destination": "https://www.fotograafpromotiesradboud.nl/",
      "permanent": true
    },
    {
      "source": "/werk",
      "destination": "/series",
      "permanent": true
    },
    {
      "source": "/portretten",
      "destination": "/portretfotos",
      "permanent": true
    },
    {
      "source": "/portretten/",
      "destination": "/portretfotos",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "view", "value": { "eq": "article" } },
        { "type": "query", "key": "id", "value": { "re": "^141(:|%3A)curriculum-vitae$" } }
      ],
      "destination": "/over-paul",
      "permanent": true
    }
  ]
}
