---
/**
 * Layout voor commerciële landingspagina's. Neemt een `LandingPagina` (src/data/landing/) en rendert de secties in
 * de vaste volgorde, elk alleen als de data ervoor bestaat. Zie "Volgorde commerciële landingspagina (bindend)" in
 * .cursor/rules/paulbreuker-regels.mdc. Wijzig de volgorde nooit; nieuwe secties komen op hun vaste plek.
 */
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import LandingBeeld from '../components/landing/LandingBeeld.astro';
import LandingFormulier from '../components/landing/LandingFormulier.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingImpressie from '../components/landing/LandingImpressie.astro';
import LandingLocaties from '../components/landing/LandingLocaties.astro';
import LandingOverPaul from '../components/landing/LandingOverPaul.astro';
import LandingPakketten from '../components/landing/LandingPakketten.astro';
import LandingUitleg from '../components/landing/LandingUitleg.astro';
import LandingVragen from '../components/landing/LandingVragen.astro';
import Statement from '../components/Statement.astro';
import { impressieAfbeeldingen, impressieSchemaAfbeeldingen } from '../lib/landing-impressie';
import { segmentenTekst } from '../lib/segmenten';
import { breadcrumbList, faqPage, imageGallery, service } from '../lib/schema';
import type { LandingPagina } from '../data/landing/types';

interface Props {
  pagina: LandingPagina;
}

const { pagina } = Astro.props;
const pad = `/${pagina.slug}`;
/** Uitleg-blokken direct na Impressie in plaats van na Vragen (zie de volgorde in de opmerking hieronder). */
const uitlegNaImpressie = pagina.uitlegPlek === 'na-impressie';
/** Pakketten direct na Impressie in plaats van ervoor (zie de volgorde in de opmerking hieronder). */
const pakkettenNaImpressie = pagina.pakkettenPlek === 'na-impressie';
/** OverPaul direct vóór Pakketten in plaats van na Uitleg (zie de volgorde in de opmerking hieronder). */
const overPaulVoorPakketten = pagina.overPaulPlek === 'voor-pakketten';

// Open Graph-afbeelding: de eerste hero-foto, bijgesneden op 1200 x 630.
const ogAfbeelding = await getImage({
  src: pagina.hero.fotos[0].afbeelding,
  width: 1200,
  height: 630,
  format: 'jpg',
  fit: 'cover',
  position: 'top',
});

// Impressie: geoptimaliseerde foto's voor de ImageGallery in JSON-LD.
const impressieFotos = await impressieAfbeeldingen(pagina);

// Pakketten met een prijs zijn de enige bron voor de OfferCatalog en voor de laagste prijs (Offer.minPrice).
const pakketOffers = (pagina.pakketten?.items ?? []).flatMap((pakket) =>
  pakket.prijs === undefined ? [] : [{ name: pakket.naam, description: pakket.omschrijving, price: pakket.prijs }],
);
const laagstePakketPrijs = pakketOffers.length > 0 ? Math.min(...pakketOffers.map((offer) => offer.price)) : undefined;
if (
  laagstePakketPrijs !== undefined &&
  pagina.schema.vanPrijs !== undefined &&
  pagina.schema.vanPrijs !== laagstePakketPrijs
) {
  console.warn(
    `[LandingLayout] ${pagina.slug}: schema.vanPrijs (${pagina.schema.vanPrijs}) wijkt af van de laagste pakketprijs (${laagstePakketPrijs}). De pakketprijs wordt gebruikt voor Offer.minPrice.`,
  );
}

const jsonLd = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: pagina.breadcrumb, path: pad },
  ]),
  service({
    name: pagina.schema.dienstNaam,
    description: pagina.seo.description,
    path: pad,
    priceFrom: laagstePakketPrijs ?? pagina.schema.vanPrijs,
    packages: pakketOffers,
    serviceType: pagina.schema.serviceType,
    areaServed:
      pagina.schema.werkgebiedType === 'City'
        ? pagina.schema.werkgebied.map((naam) => ({ '@type': 'City' as const, name: naam }))
        : pagina.schema.werkgebied,
  }),
  ...(pagina.impressie
    ? [
        imageGallery({
          name: `${pagina.breadcrumb}: ${pagina.impressie.titel}`,
          path: `${pad}#impressie`,
          images: impressieSchemaAfbeeldingen(impressieFotos),
        }),
      ]
    : []),
  // FAQPage uit dezelfde data als de zichtbare vragen: de platte tekst van het antwoord (alinea's gescheiden door een
  // regeleinde), dus de zichtbare tekst en de JSON-LD komen letterlijk overeen.
  // `schema.faqSchema: false` laat de FAQPage weg (de vragen blijven zichtbaar); /trouwfotograaf-nijmegen doet dat.
  ...(pagina.vragen && pagina.schema.faqSchema !== false
    ? [
        faqPage({
          path: `${pad}#vragen`,
          vragen: pagina.vragen.items.map((item) => ({
            vraag: item.vraag,
            antwoord: item.antwoord.map(segmentenTekst).join('\n'),
          })),
        }),
      ]
    : []),
];
---

<BaseLayout
  title={pagina.seo.title}
  description={pagina.seo.description}
  canonical={pad}
  ogImage={ogAfbeelding.src}
  jsonLd={jsonLd}
>
  <!--
    VOLGORDE LANDINGSPAGINA (bindend, zie .cursor/rules/paulbreuker-regels.mdc):
    1. Hero
    2. Werkwijze
    3. Pakketten
    4. Impressie
    5. OverPaul
    5b. Locaties ("Waar ik fotografeer"; alleen met data; nog niet in de regels-lijst, zie README)
    6. Vragen
    7. Uitleg
    8. Reviews
    9. Aanvraagformulier
    10. Beeld (foto van rand tot rand, geen kop)
    UITZONDERING op uitdrukkelijk verzoek (nu alleen /trouwfotograaf-nijmegen): met `pakkettenPlek === 'na-impressie'`
    staan Pakketten na Impressie, met `overPaulPlek === 'voor-pakketten'` staat OverPaul direct vóór Pakketten, en met
    `uitlegPlek === 'na-impressie'` staan de Uitleg-blokken direct na Pakketten. Volgorde daar: Hero, Werkwijze,
    Impressie, OverPaul, Pakketten, Uitleg, Locaties, Vragen, Reviews, Formulier. Zonder die velden verandert er niets
    aan de bindende volgorde hierboven.
    Daarna volgt de gedeelde footer (via BaseLayout). Een sectie wordt alleen getoond als de data ervoor bestaat.
    Elke sectie zit in een eigen .sectie-wrapper met alleen padding-block (--sectie-ruimte); geen margins die van
    buren afhangen.
  -->
  <div class="sectie sectie--hero">
    <LandingHero hero={pagina.hero} />
  </div>

  {
    pagina.werkwijze && (
      <div class="sectie">
        <Statement
          label={pagina.werkwijze.label}
          tekst={pagina.werkwijze.tekst}
          link={pagina.werkwijze.link}
          ariaLabel="Werkwijze"
        />
      </div>
    )
  }

  {
    overPaulVoorPakketten && !pakkettenNaImpressie && pagina.overPaul && (
      <div class="sectie">
        <LandingOverPaul overPaul={pagina.overPaul} />
      </div>
    )
  }

  {
    !pakkettenNaImpressie && pagina.pakketten && (
      <div class="sectie">
        <LandingPakketten pakketten={pagina.pakketten} noot={pagina.pakkettenNoot} nootPakket={pagina.pakkettenNootPakket} />
      </div>
    )
  }

  {
    pagina.impressie && (
      <div class="sectie">
        <LandingImpressie impressie={pagina.impressie} />
      </div>
    )
  }

  {
    overPaulVoorPakketten && pakkettenNaImpressie && pagina.overPaul && (
      <div class="sectie">
        <LandingOverPaul overPaul={pagina.overPaul} />
      </div>
    )
  }

  {
    pakkettenNaImpressie && pagina.pakketten && (
      <div class="sectie">
        <LandingPakketten pakketten={pagina.pakketten} noot={pagina.pakkettenNoot} nootPakket={pagina.pakkettenNootPakket} />
      </div>
    )
  }

  <!-- Uitleg op de afwijkende plek (alleen met `uitlegPlek: 'na-impressie'`): elk blok een eigen .sectie-wrapper. -->
  {
    uitlegNaImpressie &&
      pagina.uitleg?.map((blok, index) => (
        <div class="sectie">
          <LandingUitleg blok={blok} nummer={index + 1} />
        </div>
      ))
  }

  {
    !overPaulVoorPakketten && pagina.overPaul && (
      <div class="sectie">
        <LandingOverPaul overPaul={pagina.overPaul} />
      </div>
    )
  }

  <!-- Locaties ("Waar ik fotografeer"): alleen met minstens één plek, anders ook geen lege .sectie-wrapper. -->
  {
    pagina.locaties && pagina.locaties.items.length > 0 && (
      <div class="sectie">
        <LandingLocaties locaties={pagina.locaties} />
      </div>
    )
  }

  {
    pagina.vragen && (
      <div class="sectie">
        <LandingVragen vragen={pagina.vragen} />
      </div>
    )
  }

  <!-- Uitleg op de vaste plek (standaard): na Vragen en vóór Reviews. Elk blok een eigen .sectie-wrapper. -->
  {
    !uitlegNaImpressie &&
      pagina.uitleg?.map((blok, index) => (
        <div class="sectie">
          <LandingUitleg blok={blok} nummer={index + 1} />
        </div>
      ))
  }

  <!-- Nog te bouwen: Reviews (pagina.reviews); komt na Uitleg en vóór het formulier. -->

  <!-- Aanvraagformulier: komt na Reviews (of Pakketten) en vóór Beeld. -->
  {
    pagina.formulier && (
      <div class="sectie">
        <LandingFormulier formulier={pagina.formulier} />
      </div>
    )
  }

  <!-- Beeld: altijd de laatste sectie, onder het formulier en direct vóór de footer. -->
  {
    pagina.beeld && (
      <div class="sectie sectie--beeld">
        <LandingBeeld beeld={pagina.beeld} />
      </div>
    )
  }
</BaseLayout>

<style>
  /* Alleen padding-block: de ruimte tussen twee secties is de som van twee halve waarden, ongeacht de volgorde. */
  .sectie {
    padding-block: calc(var(--sectie-ruimte) / 2);
  }

  /* De hero regelt zijn eigen ruimte onder de header; onderaan de gewone halve sectieruimte. */
  .sectie--hero {
    padding-top: 0;
  }

  /* Het beeld van rand tot rand sluit onderaan direct aan op de footer: geen ruimte eronder. */
  .sectie--beeld {
    padding-bottom: 0;
  }
</style>
