---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { webSite, type AnySchema } from '../lib/schema';
import { DEFAULT_OG_IMAGE } from '../data/site';
import { bruiloftenDeelafbeelding } from '../lib/og-beeld';
import fontMedium from '../assets/fonts/satoshi-medium.woff2?url';
import fontBold from '../assets/fonts/satoshi-bold.woff2?url';

interface Props {
  /** Verplicht, geen standaardwaarde. Rond 60 tekens. */
  title: string;
  /** Verplicht, geen standaardwaarde. Rond 155 tekens. */
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra JSON-LD voor deze pagina. WebSite wordt altijd automatisch toegevoegd. */
  jsonLd?: AnySchema[];
  /** Vervangt de robots-regel, bijvoorbeeld "noindex" op een lege /blog. */
  robots?: string;
  /** Standaard `website`. Blogposts gebruiken `article`. */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Pad van de RSS-feed. Alleen de blogpagina's zetten dit. */
  rssHref?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Header tonen (standaard ja). /portfolio zet hem uit. */
  header?: boolean;
  /** Footer tonen (standaard ja). /portfolio zet hem uit. */
  footer?: boolean;
  /** Extra class op <html> voor paginabrede stijl. */
  htmlClass?: string;
}

const {
  title,
  description,
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  noindex,
  jsonLd = [],
  robots,
  ogType,
  publishedTime,
  modifiedTime,
  rssHref,
  ogImageWidth,
  ogImageHeight,
  header = true,
  footer = true,
  htmlClass,
} = Astro.props;

const schemas: AnySchema[] = [webSite(), ...jsonLd];
// Zonder eigen og:image: eerst DEFAULT_OG_IMAGE (nu leeg), anders het beeld van /portfolio/bruiloften.
const deelafbeelding = ogImage ?? DEFAULT_OG_IMAGE ?? (await bruiloftenDeelafbeelding());
---

<!doctype html>
<html lang="nl" class={htmlClass}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google toont alleen favicons die een veelvoud van 48 px zijn (48, 96, 192): daarom de PNG's naast de SVG en ICO. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontMedium} as="font" type="font/woff2" crossorigin />
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={deelafbeelding}
      noindex={noindex}
      robots={robots}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      rssHref={rssHref}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      jsonLd={schemas}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Ga naar de inhoud</a>
    {header && <Header />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>
