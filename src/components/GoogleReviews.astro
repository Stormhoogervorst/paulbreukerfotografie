---
/**
 * Google-reviews onderaan een commerciële pagina, als gewone HTML (geen iframe, widget of JavaScript).
 * Toont alleen reviews met de gevraagde categorie (src/config/reviews.ts). Zonder reviews rendert het component niets:
 * geen lege sectie en geen kop.
 *
 * Bewust GEEN structured data (geen JSON-LD, microdata of itemprop): de enige aggregateRating op de pagina komt uit
 * RatingSnippet.astro.
 */
import {
  googleRating,
  reviewsVoorCategorie,
  writeReviewUrl,
  type ReviewCategory,
} from '../config/reviews';

interface Props {
  category: ReviewCategory;
  limit?: number;
  title?: string;
}

const { category, limit = 6, title = 'Wat klanten zeggen' } = Astro.props;

const reviews = reviewsVoorCategorie(category, limit);

const maandJaar = new Intl.DateTimeFormat('nl-NL', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const maandJaarTekst = (datum: string) => {
  const [jaar, maand] = datum.split('-').map(Number);
  return maandJaar.format(new Date(Date.UTC(jaar, maand - 1, 1)));
};
const sterren = (aantal: number) => '★'.repeat(aantal) + '☆'.repeat(5 - aantal);

const score = googleRating.value.toFixed(1).replace('.', ',');
const KOP_ID = `reviews-titel-${category}`;
---

{
  reviews.length > 0 && (
    <section class="reviews" id="reviews" aria-labelledby={KOP_ID}>
      <h2 id={KOP_ID} class="reviews__titel">
        {title}
      </h2>

      <p class="reviews__samenvatting">
        {score} <span aria-hidden="true">{sterren(Math.round(googleRating.value))}</span> · {googleRating.count}{' '}
        {googleRating.count === 1 ? 'review' : 'reviews'} op Google
      </p>

      <ul class="reviews__raster" role="list">
        {reviews.map((review) => (
          <li class="reviews__item">
            <figure class="review">
              <blockquote class="review__tekst">
                <p>{review.text}</p>
              </blockquote>
              <figcaption class="review__bron">
                <span class="review__auteur">{review.author}</span>
                {review.context && <span class="review__context">{review.context}</span>}
                <span class="review__meta">
                  <span class="review__sterren" role="img" aria-label={`${review.rating} van 5 sterren`}>
                    <span aria-hidden="true">{sterren(review.rating)}</span>
                  </span>
                  <time datetime={review.date}>{maandJaarTekst(review.date)}</time>
                </span>
                <span class="review__label">Google-review</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <p class="reviews__links">
        <a href={googleRating.url} target="_blank" rel="noopener">
          Bekijk alle reviews op Google <span aria-hidden="true">→</span>
        </a>
        <a href={writeReviewUrl} target="_blank" rel="noopener">
          Schrijf een review
        </a>
      </p>
    </section>
  )
}

<style>
  /* Geen eigen buitenmarges: de verticale ruimte rond de sectie komt van de .sectie-wrapper in LandingLayout.astro. */
  .reviews {
    padding-inline: var(--gutter);
    scroll-margin-top: clamp(2rem, 5vw, 6rem);
  }

  .reviews__titel {
    margin: 0 0 var(--space-3);
  }

  .reviews__samenvatting {
    margin: 0 0 var(--space-5);
    font-size: var(--font-size-body);
    line-height: var(--intro-lh);
  }

  .reviews__raster {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Haarlijn boven elke review, zoals in Vragen en Diensten: geen kaarten, schaduw of afgeronde hoeken. */
  .reviews__item {
    margin: 0;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--ink);
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    margin: 0;
  }

  .review__tekst {
    margin: 0;
  }

  .review__tekst p {
    max-width: 30em;
    margin: 0;
    font-size: var(--font-size-body);
    line-height: 1.3;
  }

  .review__bron {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: auto;
    font-size: var(--font-size-small);
    line-height: 1.3;
  }

  .review__auteur {
    font-weight: 700;
  }

  .review__context,
  .review__label {
    color: var(--ink-zacht);
  }

  .review__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75em;
  }

  .review__sterren {
    letter-spacing: 0.1em;
  }

  .reviews__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5em;
    max-width: none;
    margin: var(--space-5) 0 0;
  }

  /* Tekstlinks met streep eronder, zoals de CTA's in de hero. */
  .reviews__links a {
    display: inline-block;
    padding-block: 0.4rem; /* raakvlak */
    font-size: var(--font-size-body);
    line-height: 1.1;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .reviews__links a:hover {
    text-decoration-thickness: 2px;
  }

  @media (min-width: 700px) {
    .reviews__raster {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .reviews__raster {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
