---
/**
 * Voettekst: een CSS Grid met vijf directe kinderen, in DOM-volgorde:
 *   (a) tagline, (b) hoofdnavigatie, (c) gerelateerde pagina's, (d) wordmark, (e) onderste blok.
 * Desktop (vanaf 900px): "tagline nav" / "gerelateerd gerelateerd" / "wordmark wordmark" / "onder onder".
 * Onder 900px stapelt alles in DOM-volgorde. Het wordmark is aria-hidden en niet focusbaar.
 * Alle gegevens komen uit src/data/site.ts (dezelfde bron als de Header). Geen JavaScript.
 */
import {
  CONTACT,
  FOOTER_LANDING,
  FOOTER_NAV,
  FOOTER_SOCIALS,
  FOOTER_TEKST,
  FOOTER_TEKST_BREUK_NA,
  FOOTER_WORDMARK,
  PRIVACY,
} from '../data/site';

const year = new Date().getFullYear();
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

// Tagline in twee delen voor de vaste regelbreuk op desktop (op mobiel lopen ze gewoon door).
const breukIndex = FOOTER_TEKST.indexOf(FOOTER_TEKST_BREUK_NA);
const splitsAt = breukIndex === -1 ? FOOTER_TEKST.length : breukIndex + FOOTER_TEKST_BREUK_NA.length;
const regel1 = FOOTER_TEKST.slice(0, splitsAt).trim();
const regel2 = FOOTER_TEKST.slice(splitsAt).trim();
---

<footer class="site-footer">
  <!-- TODO(paul): tekst goedkeuren (staat in src/data/site.ts). -->
  <p class="site-footer__tagline">
    <span class="site-footer__regel">{regel1}</span>{regel2 && ' '}<span class="site-footer__regel">{regel2}</span>
  </p>

  <nav class="site-footer__nav" aria-label="Footernavigatie">
    <ul class="site-footer__nav-hoofd">
      {
        FOOTER_NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <nav class="site-footer__gerelateerd" aria-label="Gerelateerde pagina's">
    <ul class="site-footer__landing">
      {
        FOOTER_LANDING.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Decoratief: de naam staat al in de header. -->
  <div class="site-footer__wordmark" aria-hidden="true">{FOOTER_WORDMARK}</div>

  <div class="site-footer__onder">
    <div class="site-footer__contact">
      {
        CONTACT.email ? (
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        ) : (
          // TODO(paul): e-mailadres invullen in src/data/site.ts.
          <span class="todo">TODO(paul)</span>
        )
      }
      <!-- TODO(paul): bevestig dat dit telefoonnummer nog klopt. -->
      <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
    </div>

    <span class="site-footer__dot" aria-hidden="true">•</span>

    <ul class="site-footer__socials">
      {
        FOOTER_SOCIALS.map((social) => (
          <li>
            <a href={social.href} rel="me noopener" target="_blank">
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobiel: één rij (copyright + privacy). Desktop: display: contents, de twee delen staan dan los in het grid. -->
    <div class="site-footer__legal">
      <span class="site-footer__copy">© {year} Paul Breuker Fotografie</span>
      <a class="site-footer__privacy" href={PRIVACY.href}>{PRIVACY.label}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* De breedte van de voettekst is de basis voor het wordmark (cqw). */
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'tagline'
      'nav'
      'gerelateerd'
      'wordmark'
      'onder';
    align-items: start;
    /* Zelfde zijmarge als header en pagina's (--gutter), links en rechts. */
    padding: 4rem var(--gutter) calc(1.5rem + env(safe-area-inset-bottom, 0px));
    /* Zwarte voettekst met witte tekst: de inktkleuren gelden hier omgekeerd, dus ook de focusrand (gebruikt --ink). */
    --ink: #fff;
    --ink-zacht: #b3b3b3; /* secundaire tekst op zwart; contrast ca. 10:1 */
    background: var(--ink-zwart);
    color: var(--ink);
    font-weight: 500;
  }

  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Alle links in de voettekst: dezelfde onderstrepingsstijl. */
  .site-footer a {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* ---------- (a) Tagline ---------- */
  .site-footer__tagline {
    grid-area: tagline;
    max-width: none;
    min-width: 0;
    margin: 0;
    font-size: clamp(1.75rem, 7vw, 2.5rem);
    font-weight: 400; /* alleen Satoshi 500 en 700 zijn zelf gehost: 400 valt terug op 500 */
    line-height: 1.08;
    text-wrap: balance; /* mobiel: natuurlijke afbreking zonder weesregel */
    hyphens: none; /* nooit midden in een woord afbreken */
    overflow-wrap: normal;
  }

  /* ---------- (b) Hoofdnavigatie (mobiel: twee kolommen, in leesvolgorde) ---------- */
  .site-footer__nav {
    grid-area: nav;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    margin-top: 2rem; /* tagline naar hoofdnavigatie */
  }

  .site-footer__nav-hoofd {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    justify-content: start;
    column-gap: 1.5rem;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .site-footer__nav li,
  .site-footer__gerelateerd li {
    display: flex;
  }

  .site-footer__nav a,
  .site-footer__gerelateerd a {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* klikgebied op mobiel en tablet */
    text-decoration-line: none; /* geen onderstreping in rust */
  }

  .site-footer__nav a:hover,
  .site-footer__nav a:focus-visible,
  .site-footer__nav a[aria-current='page'],
  .site-footer__gerelateerd a:hover,
  .site-footer__gerelateerd a:focus-visible,
  .site-footer__gerelateerd a[aria-current='page'] {
    text-decoration-line: underline;
  }

  /* ---------- (c) Gerelateerde pagina's: eigen rij, links uitgelijnd, mag wrappen ---------- */
  .site-footer__gerelateerd {
    grid-area: gerelateerd;
    min-width: 0;
    /* Zelfde haarlijn als de rest van de site (1px, 20% inkt). --ink is hier wit. */
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  /* Landingspagina's: donkergrijs op zwart. #8a8a8a heeft contrast 7:1 (AA). */
  .site-footer__landing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    color: #8a8a8a;
    font-size: 1rem;
    font-weight: 500;
  }

  .site-footer__landing a {
    color: inherit;
  }

  /* ---------- (c) Wordmark: één regel van marge tot marge ---------- */
  .site-footer__wordmark {
    grid-area: wordmark;
    /* "Paul Breuker" is 5,36em ink breed bij -0,04em letter-spacing (zelfde meting als de hero),
       dus 100cqw / 5,36 vult de breedte tussen de marges. */
    font-size: calc((100vw - 2 * var(--gutter)) / 5.36);
    font-size: calc(100cqw / 5.36);
    margin: 4rem 0 0 -0.081em; /* links naar wordmark; linkerzijbeen van de P op de gutter */
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: var(--ink);
    user-select: none;
  }

  /* ---------- (d) Onderste blok (mobiel: drie lagen onder elkaar) ---------- */
  .site-footer__onder {
    grid-area: onder;
    display: grid;
    gap: 1.5rem; /* tussen de lagen */
    margin-top: 2.5rem; /* wordmark naar onderste blok */
    font-size: 1rem;
  }

  /* Raakvlak van minimaal 44px zonder de visuele regelafstand te verstoren: padding vergroot het
     klikvlak, de negatieve marge maakt dat ongedaan voor de layout. */
  .site-footer__onder a {
    display: inline-block;
    padding-block: 0.6875rem;
    margin-block: -0.6875rem;
  }

  .site-footer__contact {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
  }

  .site-footer__dot {
    display: none;
  }

  .site-footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.875rem;
  }

  .site-footer__copy {
    color: var(--ink-zacht);
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 900px) {
    .site-footer {
      /* Twee gelijke kolommen: de tagline krijgt de linkerhelft, de hoofdnavigatie de rechter. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'tagline nav'
        'gerelateerd gerelateerd'
        'wordmark wordmark'
        'onder onder';
      column-gap: 2rem;
      padding-top: clamp(5rem, 10vw, 12rem);
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }

    .site-footer__tagline {
      max-width: none; /* de kolom is al ongeveer de helft van de rij */
      font-size: clamp(1.75rem, 3.2vw, 4.5rem);
      align-self: start;
      text-wrap: wrap;
    }

    /* Vaste regelbreuk na "portret,". */
    .site-footer__regel {
      display: block;
    }

    .site-footer__nav {
      justify-self: end;
      margin-top: 0;
      align-self: end; /* naast de onderste regel van de tagline, op de rechterrand */
      align-items: flex-end;
      max-width: 100%;
    }

    .site-footer__nav-hoofd {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0.5rem 1.6vw;
      font-size: clamp(1rem, 1.05vw, 1.375rem);
    }

    .site-footer__nav a,
    .site-footer__gerelateerd a {
      min-height: 0;
      white-space: nowrap;
    }

    .site-footer__gerelateerd {
      margin-top: clamp(1.5rem, 2.5vw, 2.5rem);
      padding-top: clamp(1.25rem, 2vw, 2rem);
    }

    .site-footer__landing {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: flex-start;
      align-items: center;
      gap: 1.25rem; /* vaste kolom- en rijafstand, ook als de lijst naar een tweede regel loopt */
      font-size: clamp(0.8125rem, 0.85vw, 0.9375rem);
    }

    .site-footer__landing li {
      flex: 0 0 auto;
    }

    .site-footer__wordmark {
      margin-top: clamp(4rem, 11vw, 14rem);
    }

    /* Twee groepen met space-between: e-mail, telefoon, • en copyright links; socials en privacy rechts. */
    .site-footer__onder {
      grid-template-columns: auto auto auto minmax(0, 1fr) auto auto;
      grid-template-areas: 'contact dot copy . socials privacy';
      align-items: baseline;
      column-gap: 0.75rem;
      margin-top: 2rem;
      font-size: clamp(0.875rem, 0.9vw, 1rem);
    }

    .site-footer__contact {
      grid-area: contact;
      display: flex;
      gap: 1.25rem;
    }

    .site-footer__dot {
      grid-area: dot;
      display: inline;
    }

    .site-footer__legal {
      display: contents;
      font-size: inherit;
    }

    .site-footer__copy {
      grid-area: copy;
      color: var(--ink);
    }

    .site-footer__socials {
      grid-area: socials;
      gap: 1.25rem;
    }

    .site-footer__privacy {
      grid-area: privacy;
      margin-left: 0.5rem;
    }
  }
</style>
