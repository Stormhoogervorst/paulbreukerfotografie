---
/**
 * Header: statisch (niet sticky), zonder JavaScript.
 * - Eén menu voor alle schermbreedtes: een "menu"-knop rechts (native <details>/<summary>) die een paneel opent
 *   met de navigatie en de contactgegevens. Blog staat niet in de header (wel in de footer).
 * - Vanaf 900px staat links het logo "Paul Breuker Fotografie" (klein, gelijk aan het menu) op dezelfde basislijn als
 *   de knop. Onder 900px alleen de knop; de homelink staat dan bovenaan het menu.
 */
import { CONTACT, NAV, WORDMARK } from '../data/site';
import { isHuidigePagina } from '../lib/blog';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// Blog staat bewust niet in de header (wel in de footer).
const navigatie = NAV;
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="site-header__brand" href="/">{WORDMARK}</a>

    <details class="menu">
      <summary class="menu__button">
        <span class="menu__label menu__label--open">menu</span>
        <span class="menu__label menu__label--close">sluiten</span>
      </summary>

      <div class="menu__panel">
        <nav aria-label="Hoofdnavigatie">
          <ul class="menu__list menu__list--nav">
            <li>
              <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>home</a>
            </li>
            {
              navigatie.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isHuidigePagina(item.href, currentPath) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <ul class="menu__list" aria-label="Contact">
          <li>
            <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
          </li>
          <li>
            {
              CONTACT.email ? (
                <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              ) : (
                // TODO(paul): e-mailadres invullen in src/data/site.ts.
                <span class="todo">TODO(paul)</span>
              )
            }
          </li>
        </ul>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative; /* anker voor het mobiele paneel; de header zelf is niet sticky */
    z-index: 20; /* boven het wordmark in de hero */
    background: var(--canvas);
    font-size: var(--font-size-small);
    font-weight: 500;
    line-height: 1.8; /* 28,8px per regel, zoals in de referentie */
  }

  .site-header a {
    text-decoration: none;
  }

  .site-header a:hover,
  .site-header a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .site-header__brand {
    font-size: var(--font-size-small); /* gelijk aan de menu-items: het logo concurreert niet met de H1 */
    font-weight: 500; /* dunner dan de vette hero-titel; 500 is het lichtste gewicht dat self-hosted is */
    line-height: inherit; /* zelfde regelbox als de menu-items: dezelfde basislijn */
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* ---------- Balk ---------- */
  .site-header__bar {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) var(--gutter);
  }

  /* Logo alleen vanaf 900px; de knop staat altijd rechts. */
  .site-header__brand {
    display: none;
  }

  .menu {
    margin-left: auto;
  }

  .menu__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-right: -0.75rem; /* tekst loopt uit op de rechtermarge, het raakvlak steekt erbuiten */
    padding-inline: 0.75rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .menu__button::-webkit-details-marker {
    display: none;
  }

  .menu__button:hover .menu__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .menu__button:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 0;
  }

  .menu__label--close,
  .menu[open] .menu__label--open {
    display: none;
  }

  .menu[open] .menu__label--close {
    display: inline;
  }

  .menu__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-2) var(--gutter) var(--space-5);
    background: var(--canvas);
    border-bottom: 1px solid rgb(21 21 21 / 0.15);
  }

  .menu__list {
    display: grid;
  }

  .menu__list a,
  .menu__list .todo {
    display: flex;
    align-items: center;
    min-height: 44px; /* ruim raakvlak */
  }

  .menu__list--nav a {
    font-size: var(--font-size-body);
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 900px) {
    .site-header__bar {
      /* Logo en menuknop lopen van gutter tot gutter, gelijk aan het wordmark in de hero. */
      padding-block: var(--space-3) 0;
    }

    .site-header__brand {
      display: block;
      margin-left: -0.09em; /* de vorm van de P begint op de gutter, net als het wordmark in de hero */
    }
  }
</style>
