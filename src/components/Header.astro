---
/**
 * Header: statisch (niet sticky), wit, zonder JavaScript.
 * - Vanaf 900px: drie kolommen (wordmark, contact, navigatie). Socials staan alleen in de footer.
 * - Onder 900px: alleen een "menu"-knop rechts (native <details>/<summary>), zonder naam.
 * Er is één blok per breakpoint; het andere blok is `display: none` en dus ook
 * niet in de toegankelijkheidsboom.
 */
import { CONTACT, NAV, WORDMARK } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <!-- Desktop: vanaf 900px -->
  <div class="site-header__desktop">
    <a class="site-header__brand" href="/">{WORDMARK}</a>

    <ul class="site-header__col" aria-label="Contact">
      <li>
        {
          CONTACT.email ? (
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          ) : (
            // TODO(paul): e-mailadres invullen in src/data/site.ts.
            <span class="todo">TODO(paul)</span>
          )
        }
      </li>
      <li>
        <!-- TODO(paul): bevestig dat dit telefoonnummer nog klopt. -->
        <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
      </li>
    </ul>

    <nav class="site-header__nav" aria-label="Hoofdnavigatie">
      <ul class="site-header__col">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Mobiel: onder 900px -->
  <div class="site-header__mobile">
    <!-- Geen naam in de mobiele header: alleen de menuknop. De homelink staat bovenaan het menu. -->
    <details class="menu">
      <summary class="menu__button">
        <span class="menu__label menu__label--open">menu</span>
        <span class="menu__label menu__label--close">sluiten</span>
      </summary>

      <div class="menu__panel">
        <nav aria-label="Hoofdnavigatie">
          <ul class="menu__list menu__list--nav">
            <li>
              <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>home</a>
            </li>
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <ul class="menu__list" aria-label="Contact">
          <li>
            <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
          </li>
          <li>
            {
              CONTACT.email ? (
                <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              ) : (
                // TODO(paul): e-mailadres invullen in src/data/site.ts.
                <span class="todo">TODO(paul)</span>
              )
            }
          </li>
        </ul>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative; /* anker voor het mobiele paneel; de header zelf is niet sticky */
    z-index: 20; /* boven het wordmark in de hero */
    background: var(--paper);
    font-size: var(--font-size-small);
    font-weight: 500;
    line-height: 1.8; /* 28,8px per regel, zoals in de referentie */
  }

  .site-header a {
    text-decoration: none;
  }

  .site-header a:hover,
  .site-header a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .site-header__brand {
    font-size: 1.75rem; /* 28px */
    font-weight: 500; /* dunner dan de vette hero-titel; 500 is het lichtste gewicht dat self-hosted is */
    line-height: calc(var(--font-size-small) * 1.8); /* zelfde regelbox als de kolommen: gelijke bovenlijn */
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* ---------- Mobiel ---------- */
  .site-header__desktop {
    display: none;
  }

  .site-header__mobile {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-3) var(--gutter);
  }

  .menu__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-right: -0.75rem; /* tekst loopt uit op de rechtermarge, het raakvlak steekt erbuiten */
    padding-inline: 0.75rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .menu__button::-webkit-details-marker {
    display: none;
  }

  .menu__button:hover .menu__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .menu__button:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 0;
  }

  .menu__label--close,
  .menu[open] .menu__label--open {
    display: none;
  }

  .menu[open] .menu__label--close {
    display: inline;
  }

  .menu__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-2) var(--gutter) var(--space-5);
    background: var(--paper);
    border-bottom: 1px solid rgb(21 21 21 / 0.15);
  }

  .menu__list {
    display: grid;
  }

  .menu__list a,
  .menu__list .todo {
    display: flex;
    align-items: center;
    min-height: 44px; /* ruim raakvlak */
  }

  .menu__list--nav a {
    font-size: var(--font-size-body);
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 900px) {
    .site-header__mobile {
      display: none;
    }

    .site-header__desktop {
      display: grid;
      /* De contactkolom start op dezelfde plek als in de referentie (34,6vw + 14,6vw); de navigatie
         sluit rechts aan op de rechterrand van het wordmark in de hero (83vw breed). */
      grid-template-columns: 49.2vw minmax(0, 1fr) auto;
      align-items: start;
      width: var(--wordmark-width);
      margin-left: var(--gutter);
      padding-top: clamp(0.75rem, 1.6vw, 1.75rem);
    }

    .site-header__col {
      display: block;
    }

    .site-header__nav {
      justify-self: end;
      text-align: right;
    }
  }
</style>
