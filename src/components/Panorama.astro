---
/**
 * Panoramafoto: één foto van rand tot rand, direct onder "Exposities". Visueel tussenstuk: geen kop, geen tekst,
 * geen landmark. Geen eigen buitenmarges: de verticale ruimte komt van de .sectie-wrapper in index.astro.
 * De foto staat in zijn originele verhouding (geen uitsnede), dus geen layoutverschuiving.
 * Content: home.panorama in src/data/home.ts.
 */
import { Picture } from 'astro:assets';
import { BREEDTES_HERO, FALLBACK_FORMAAT, FORMATEN } from '../lib/beeld';
import { home } from '../data/home';
import type { ImageMetadata } from 'astro';
import { getHomeImage } from '../lib/images';

interface Props {
  /** Eigen foto in plaats van die van de homepage (bijvoorbeeld op /privacy). Zonder: `home.panorama`. */
  bron?: ImageMetadata;
  /** Alt-tekst bij `bron`. */
  alt?: string;
}

const { bron, alt: eigenAlt } = Astro.props;
const { afbeelding, alt: homeAlt } = home.panorama;
const image = bron ?? getHomeImage(afbeelding);
const alt = bron ? (eigenAlt ?? '') : homeAlt;
---

<div class="panorama" style={image ? `aspect-ratio: ${image.width} / ${image.height}` : 'aspect-ratio: 5 / 2'}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        width={image.width}
        height={image.height}
        widths={BREEDTES_HERO}
        sizes="100vw"
        formats={FORMATEN}
        fallbackFormat={FALLBACK_FORMAAT}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <p class="panorama__placeholder">TODO(paul): foto <code>{afbeelding}</code> ontbreekt</p>
    )
  }
</div>

<style>
  /* Volle breedte, geen marges: de wrapper in index.astro heeft alleen padding-block. */
  .panorama {
    width: 100%;
    overflow: hidden;
    background: #f2f2f2;
  }

  .panorama :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .panorama :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .panorama__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: var(--space-3);
    border: 1px dashed var(--ink);
    font-size: var(--font-size-small);
    text-align: center;
  }
</style>
