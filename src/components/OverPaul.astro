---
import { home } from '../data/home';

const { label, tekst, link } = home.overPaul;
---

<section class="over-paul" aria-labelledby="over-paul-titel">
  <div class="over-paul__inner">
    <h2 id="over-paul-titel" class="over-paul__label">{label}</h2>

    <div class="over-paul__body">
      <p class="over-paul__tekst">{tekst}</p>
      <a class="over-paul__link" href={link.href}>
        {link.label} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ---------- Over Paul (mobiel eerst) ---------- */
  .over-paul {
    --tekst-size: clamp(1.5rem, 6vw, 2rem);
    /* Geen eigen buitenmarges: de verticale ruimte komt van de .sectie-wrapper in index.astro. */
    padding: 0 var(--gutter);
  }

  /* Dunne lijn over de volle breedte binnen de marges (dezelfde als header en hero). */
  .over-paul__inner {
    padding-top: var(--space-4);
    border-top: 1px solid rgb(21 21 21 / 0.2);
  }

  .over-paul__label {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-small); /* 16px */
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .over-paul__tekst {
    max-width: none;
    margin: 0;
    font-size: var(--tekst-size);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-indent: 2.5em;
    text-wrap: pretty;
    hyphens: none;
  }

  .over-paul__link {
    display: inline-block;
    margin-top: calc(2rem - 0.4rem);
    padding-block: 0.4rem; /* raakvlak */
    font-size: var(--font-size-small);
    line-height: 1.2;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .over-paul__link:hover {
    text-decoration-thickness: 2px;
  }

  /* Zachte fade bij verschijnen in beeld. Alleen waar scroll-gestuurde animatie bestaat,
     en nooit bij prefers-reduced-motion. Zonder ondersteuning staat de tekst gewoon zichtbaar. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .over-paul__inner {
        animation: over-paul-fade linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }

      @keyframes over-paul-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
    }
  }

  /* ---------- Over Paul (desktop) ---------- */
  @media (min-width: 900px) {
    .over-paul {
      --tekst-size: clamp(1.75rem, 2.8vw, 4rem);
    }

    .over-paul__inner {
      display: grid;
      grid-template-columns: 3fr 7fr;
      column-gap: var(--gutter);
      padding-top: clamp(1.5rem, 2.5vw, 3rem);
    }

    /* Bovenkant van het label op de bovenkant van de eerste tekstregel. */
    .over-paul__label {
      align-self: start;
      margin: 0;
      padding-top: calc(var(--tekst-size) * 0.18);
    }

    .over-paul__tekst {
      text-indent: 27%; /* alleen de eerste regel; percentage van de kolombreedte */
    }
  }
</style>
