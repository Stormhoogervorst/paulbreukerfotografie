---
/**
 * Sectie "Projecten": titel die met het scrollen meebeweegt (gedeelde Marquee) en drie kaarten in één rij met verschillende formaten, plus "alle series".
 * Onafhankelijk van de buren: geen eigen buitenmarges (die komen van de .sectie-wrapper in index.astro), geen aannames over wat erboven of eronder staat.
 * Content: home.projecten in src/data/home.ts.
 */
import Marquee from './Marquee.astro';
import Photo from './Photo.astro';
import { home, type HomeProject } from '../data/home';
import { getHomeImage } from '../lib/images';

const { titel, allLink } = home.projecten;
// Als HomeProject[] getypeerd (in home.ts staat de lijst met `satisfies`, dat alleen de aanwezige velden onthoudt): zo bestaat het optionele `jaar` ook voor een kaart die het nu niet gebruikt.
const items: HomeProject[] = home.projecten.items;

// Hoge foto (rechts) en de middelste kaart: natuurlijke verhouding uit het bestand, geen uitsnede.
// Ontbreekt het bestand, dan valt de placeholder terug op 2 / 3.
const bronVan = (positie: HomeProject['positie']) => {
  const naam = items.find((project) => project.positie === positie)?.photo.name;
  return naam ? getHomeImage(naam) : undefined;
};
const rechtsBron = bronVan('rechts');
const rechtsBreedte = rechtsBron?.width ?? 600;
const rechtsHoogte = rechtsBron?.height ?? 900;
const middenBron = bronVan('midden');
const middenBreedte = middenBron?.width ?? 600;
const middenHoogte = middenBron?.height ?? 900;

// Maten per positie. Breedte en hoogte bepalen de verhouding en voorkomen layoutverschuiving.
// `sizes` op desktop = de kolombreedte uit de CSS (24vw, 30vw, max 18vw); mobiel = de huidige breedte van de kaart.
const kaart = {
  links: { width: 1200, height: 1440, widths: [480, 800, 1200, 1600], sizes: '(min-width: 900px) 24vw, 85vw' }, // 5 / 6
  midden: { width: middenBreedte, height: middenHoogte, widths: [300, 480, middenBreedte], sizes: '(min-width: 900px) 30vw, 58vw' },
  rechts: { width: rechtsBreedte, height: rechtsHoogte, widths: [300, rechtsBreedte], sizes: '(min-width: 900px) 18vw, 56vw' },
} as const;
---

<section class="projecten" aria-labelledby="projecten-titel" style={`--rechts-verhouding: ${rechtsBreedte / rechtsHoogte}`}>
  <Marquee woord={titel} kopId="projecten-titel" />

  <div class="projecten__inhoud">
    <!-- Desktop: `display: contents`, zodat de kaarten en de link in hetzelfde grid staan. role="list" houdt de lijstsemantiek in alle browsers. -->
    <ul class="projecten__rij" role="list">
      {
        items.map((project) => (
          <li class={`kaart kaart--${project.positie}`}>
            <a class="kaart__link" href={project.href}>
              <Photo
                name={project.photo.name}
                alt={project.photo.alt}
                width={kaart[project.positie].width}
                height={kaart[project.positie].height}
                widths={[...kaart[project.positie].widths]}
                sizes={kaart[project.positie].sizes}
                loading="lazy"
                position={project.photo.uitsnede}
              />
              <span class="kaart__titel">{project.title}</span>
              {project.jaar && <span class="kaart__jaar">{project.jaar}</span>}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="projecten__alle">
      <a class="projecten__alle-link" href={allLink.href}>
        <span class="projecten__alle-tekst">{allLink.label}</span>
        <svg
          class="projecten__pijl"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M3 12h17M14 5.5l6.5 6.5-6.5 6.5"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  /* ---------- Projecten (mobiel eerst) ---------- */
  .projecten {
    --titel-size: clamp(1.25rem, 2vw, 2.5rem);
    /* Geen eigen buitenmarges: de verticale ruimte komt van de .sectie-wrapper in index.astro. */
  }

  /* ----- Kaarten (mobiel: onder elkaar) ----- */
  .projecten__inhoud {
    padding-inline: var(--gutter);
  }

  .projecten__rij {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kaart--links {
    width: 85%;
  }

  /* Mobiel: kleiner en rechts uitgelijnd, zodat er links meer witruimte staat. */
  .kaart--midden {
    width: 58%;
    margin-top: 2rem;
    margin-left: auto;
  }

  /* Hoge foto: 56% van de contentbreedte, mobiel links op de gutter, natuurlijke verhouding (de hoogte volgt uit de breedte). */
  .kaart--rechts {
    width: 56%;
    margin-top: 2rem;
    margin-left: 0;
  }

  .kaart__link {
    display: block;
    text-decoration: none;
  }

  .kaart__titel {
    display: block;
    margin-top: 1rem;
    font-size: var(--titel-size);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .kaart__jaar {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--font-size-small);
    line-height: 1.3;
    color: var(--ink);
  }

  .kaart__link:hover .kaart__titel {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .projecten__alle {
    max-width: none;
    margin: 4rem 0 0;
    text-align: right;
    font-size: var(--titel-size);
    line-height: 1.15;
  }

  .projecten__alle-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding-block: 0.4rem; /* raakvlak */
    text-decoration: none;
  }

  /* Altijd onderstreept, zoals de kaarttitels bij hover. */
  .projecten__alle-tekst {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .projecten__pijl {
    flex: none;
    width: 0.9em;
    height: 0.9em;
  }

  /* ---------- Projecten (desktop) ---------- */
  @media (min-width: 900px) {
    /* Eén rij van gutter tot gutter (89vw). De drie kolommen zijn samen 72vw breed; space-between verdeelt de rest (17vw)
       gelijkmatig over twee gaten. Kolom 3: 40vw hoog volgens de verhouding van de foto, maar nooit breder dan 18vw. */
    .projecten__inhoud {
      --kolom-3: min(18vw, calc(40vw * var(--rechts-verhouding)));
      display: grid;
      grid-template-columns: 24vw 30vw var(--kolom-3);
      /* Rij 1 is zo hoog als kaart 3 (met bijschrift); de rest van de rij gaat naar rij 2. Zo staat de link onder het bijschrift van kaart 3. */
      grid-template-rows: auto 1fr;
      justify-content: space-between;
      align-items: start;
    }

    .projecten__rij {
      display: contents;
    }

    .kaart--links,
    .kaart--midden,
    .kaart--rechts {
      margin-left: 0;
      width: auto;
      grid-row: 1 / span 2; /* span: de hoogte van kaart 1 en 2 bepaalt rij 1 niet */
    }

    .kaart--links {
      grid-column: 1;
      margin-top: 0; /* bovenkant = rij-top */
    }

    .kaart--midden {
      grid-column: 2;
      margin-top: 9vw; /* grootste kaart, het laagst */
    }

    .kaart--rechts {
      grid-column: 3;
      grid-row: 1;
      margin-top: 3vw;
    }

    .projecten__alle {
      grid-column: 3;
      grid-row: 2;
      justify-self: end; /* rechterrand op --gutter */
      margin: 9vw 0 0; /* afstand onder het bijschrift van kaart 3: de link staat daarmee onder het bijschrift van kaart 2 */
    }
  }
</style>
