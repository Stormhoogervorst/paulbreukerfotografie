---
/**
 * Fotoreeks in een blogpost. Zelfde uitgangspunt als de Impressie op de landingspagina's: elke foto houdt zijn eigen
 * verhouding, de rij loopt van gutter tot gutter, en alles onder de vouw laadt lui. Alt is verplicht.
 * `src` is een pad relatief aan src/assets (zie src/lib/blog-foto.ts), of een al geïmporteerd beeld. Geen import in de MDX.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { blogFotos } from '../../lib/blog-foto';
import { BREEDTES_FOTO, FALLBACK_FORMAAT, FORMATEN } from '../../lib/beeld';

interface Foto {
  src: string | ImageMetadata;
  alt: string;
}

interface Props {
  images: Foto[];
}

const { images } = Astro.props;

if (!images?.length) {
  throw new Error('Gallery: geef minstens één foto mee.');
}
for (const foto of images) {
  if (!foto.alt?.trim()) throw new Error('Gallery: elke foto heeft een alt-tekst nodig.');
  if (typeof foto.src === 'string' && !foto.src.trim()) throw new Error('Gallery: elke foto heeft een src nodig.');
}

const fotos = await blogFotos(images);
---

<ul class="galerij">
  {
    fotos.map((foto) => (
      <li>
        <Picture
          src={foto.src}
          alt={foto.alt}
          width={foto.src.width}
          height={foto.src.height}
          widths={BREEDTES_FOTO}
          sizes="(min-width: 1280px) 40rem, (min-width: 900px) 52vw, 89vw"
          formats={FORMATEN}
          fallbackFormat={FALLBACK_FORMAAT}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))
  }
</ul>

<style>
  .galerij {
    --galerij-gap: clamp(0.75rem, 2vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--galerij-gap);
    width: 100%;
    max-width: none;
    margin: 1rem 0 2.25rem;
    padding: 0;
    list-style: none;
  }

  .galerij li {
    display: flex;
    flex: 1 1 calc(50% - var(--galerij-gap));
    align-items: flex-end;
    justify-content: center;
    min-width: min(100%, 16rem);
    max-width: 100%;
  }

  .galerij :global(picture) {
    width: 100%;
  }

  /* Een staande foto wordt nooit hoger dan 80% van het scherm; object-fit houdt de verhouding. */
  .galerij :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 80svh;
    object-fit: contain;
  }

  @media (max-width: 699px) {
    .galerij li {
      flex-basis: 100%;
    }
  }

  /* Zelfde ritme als de Impressie: de ene rij breder links, de volgende breder rechts. */
  @media (min-width: 900px) {
    .galerij li:nth-child(4n + 1),
    .galerij li:nth-child(4n + 4) {
      flex-basis: calc(58% - var(--galerij-gap));
      flex-grow: 1.4;
    }

    .galerij li:nth-child(4n + 2),
    .galerij li:nth-child(4n + 3) {
      flex-basis: calc(42% - var(--galerij-gap));
      flex-grow: 1;
    }
  }

  /* Een oneven laatste foto (bij drie stuks) vult niet de hele rij. */
  @media (min-width: 700px) {
    .galerij li:last-child:nth-child(odd) {
      flex-grow: 0;
      flex-basis: calc(50% - var(--galerij-gap));
      max-width: calc(58% - var(--galerij-gap));
    }
  }
</style>
