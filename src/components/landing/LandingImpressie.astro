---
/**
 * Impressie (landingspagina): zonder zichtbare titel (de h2 is visueel verborgen), vier foto's in twee rijen van twee, plus een
 * kleine link rechts onder de laatste rij.
 *
 * - De indeling staat in twee configuratie-constanten (rijenDesktop, rijenMobiel): per rij het aantal foto's, de breedte
 *   per foto (in vw) en de uitlijning van de rij. De breedtes plus de tussenruimtes zijn per rij samen 89vw
 *   (= 100vw min twee keer --gutter van 5,5vw), dus elke rij loopt van gutter tot gutter.
 * - Elke foto behoudt zijn eigen verhouding (geen uitsnede, geen object-fit: cover, geen gelijke hoogtes). Alleen de
 *   breedte ligt vast; de hoogte volgt uit de verhouding. Daarom staan er per foto een vaste `width`/`height` én een CSS
 *   `aspect-ratio` uit het bronbestand: geen layoutverschuiving.
 * - Het patroon herhaalt zich bij meer dan vier foto's en wordt afgekapt bij minder. Een onvolledige laatste rij gebruikt
 *   de eerste breedtes van zijn configuratie en staat links (flex-start).
 * - Desktop en mobiel hebben elk hun eigen configuratie. Daarom staan er twee lijsten in de HTML; CSS toont er één per
 *   breakpoint (de andere is display: none, dus niet voorgelezen en door `loading="lazy"` ook niet geladen).
 * - Geen bijschriften, hover, lightbox of animatie. Geen JavaScript.
 * - Indeling "rij" (data-veld `indeling`, voor staande foto's): één rij van drie foto's van gutter tot gutter, met
 *   relatieve hoogtes (`rijHoogtes`, `rijHoogtesMobiel`) en één onderlijn (`rijUitlijning`). De breedtes volgen bij het
 *   bouwen uit de beeldverhoudingen: aandeel_i = (hoogte_i × verhouding_i) / som(hoogte_j × verhouding_j), en de
 *   flex-basis is aandeel_i × (100% − totale afstand). Geen uitsnede; de hoogte volgt uit de verhouding. Zonder het veld
 *   geldt de diagonale indeling hierboven, ongewijzigd.
 * - Geen eigen buitenmarges: de verticale ruimte rond de sectie komt van de .sectie-wrapper in LandingLayout.astro.
 *
 * Content: `pagina.impressie` (zie src/data/landing/types.ts).
 */
import { Picture } from 'astro:assets';
import type { LandingImpressie } from '../../data/landing/types';

interface Props {
  impressie: LandingImpressie;
}

const { impressie } = Astro.props;

/** Indeling: standaard "diagonaal" (twee rijen van twee); "rij" = één rij van drie. */
const indeling = impressie.indeling ?? 'diagonaal';

// ---- Configuratie indeling "rij" ----
/** Relatieve hoogte per foto (desktop, vanaf 900px), van links naar rechts. Het aantal bepaalt het aantal getoonde foto's. */
const rijHoogtes = [0.8, 1, 0.68];
/** Idem voor mobiel (onder 900px). */
const rijHoogtesMobiel = [0.8, 1, 0.68];
/** align-items van de rij: "flex-end" = alle foto's op één onderlijn, de bovenkant verspringt. */
const rijUitlijning: 'flex-start' | 'flex-end' = 'flex-end';
/** Eigen uitlijning per foto (align-self), van links naar rechts. "center" zet een foto verticaal midden in de rij: boven- en onderkant liggen dan niet gelijk met de buren. */
const rijFotoUitlijning: ('flex-start' | 'center' | 'flex-end')[] = ['center', 'flex-end', 'flex-end'];
/** Extra verschuiving omhoog per foto in vw (margin-bottom bij "flex-end"), van links naar rechts. Zo ligt een foto niet meer op de onderlijn van de buren. */
const rijFotoOmhoogVw = [0, 0, 2.5];
/** Afstand tussen de foto's in vw (desktop en mobiel, gelijk aan de diagonale indeling). */
const rijAfstandDesktop = 2;
const rijAfstandMobiel = 3;
/** Breedte van de rij in vw: 100vw min twee keer --gutter (5,5vw). */
const RIJ_BREEDTE_VW = 89;
/** Een rij hoger dan dit (vw, desktop) geeft een bouw-waarschuwing; de schaal wordt niet aangepast. */
const RIJ_MAX_HOOGTE_VW = 50;

/** Id van de <h2> (visueel verborgen); de sectie verwijst ernaar met aria-labelledby. */
const KOP_ID = 'impressie-titel';

interface RijConfig {
  aantal: number;
  /** Breedte per foto in vw. */
  breedtes: number[];
  /** align-items van de rij: bepaalt of onderkanten (flex-end) of bovenkanten (flex-start) gelijk liggen. */
  uitlijning: 'flex-start' | 'flex-end';
}

/** Desktop (vanaf 900px): per rij 50 + 37 + 2 = 89 en 36 + 51 + 2 = 89 vw. */
const rijenDesktop: { rijen: RijConfig[]; afstand: number } = {
  rijen: [
    { aantal: 2, breedtes: [50, 37], uitlijning: 'flex-end' },
    { aantal: 2, breedtes: [36, 51], uitlijning: 'flex-start' },
  ],
  afstand: 2, // vw, tussen foto's in een rij en tussen rijen
};

/** Mobiel (onder 900px): per rij 52 + 34 + 3 = 89 vw. */
const rijenMobiel: { rijen: RijConfig[]; afstand: number } = {
  rijen: [
    { aantal: 2, breedtes: [52, 34], uitlijning: 'flex-end' },
    { aantal: 2, breedtes: [34, 52], uitlijning: 'flex-start' },
  ],
  afstand: 3, // vw
};

const WIDTHS = [320, 480, 640, 960, 1280];
const MIN_HOOGTEVERHOUDING = 0.6;

interface Slot {
  index: number;
  breedte: number;
}
interface Rij {
  uitlijning: RijConfig['uitlijning'];
  slots: Slot[];
}

/** Verdeelt de foto's over de rijen van een configuratie; de cyclus herhaalt zich, een onvolledige laatste rij staat links. */
function verdeel(config: RijConfig[], aantalFotos: number): Rij[] {
  const rijen: Rij[] = [];
  let index = 0;
  for (let r = 0; index < aantalFotos; r++) {
    const rij = config[r % config.length];
    const slots: Slot[] = [];
    for (let i = 0; i < rij.aantal && index < aantalFotos; i++, index++) {
      slots.push({ index, breedte: rij.breedtes[i] });
    }
    rijen.push({ uitlijning: slots.length < rij.aantal ? 'flex-start' : rij.uitlijning, slots });
  }
  return rijen;
}

const aantalFotos = impressie.fotos.length;
const indelingen = [
  { naam: 'desktop', afstand: rijenDesktop.afstand, rijen: verdeel(rijenDesktop.rijen, aantalFotos) },
  { naam: 'mobiel', afstand: rijenMobiel.afstand, rijen: verdeel(rijenMobiel.rijen, aantalFotos) },
];

/** Breedte per foto (vw) in beide indelingen, voor het `sizes`-attribuut. */
const breedteDesktop: number[] = [];
const breedteMobiel: number[] = [];

for (const rij of indelingen[0].rijen) for (const slot of rij.slots) breedteDesktop[slot.index] = slot.breedte;
for (const rij of indelingen[1].rijen) for (const slot of rij.slots) breedteMobiel[slot.index] = slot.breedte;

// Bewaking: de laagste foto in een rij is minstens 60% zo hoog als de hoogste. Bij een overtreding: bouw-waarschuwing.
// Pas dan de breedtes van die rij aan in de configuratie (de som blijft 89vw); de volgorde van de foto's blijft gelijk.
// Een staande foto krijgt de smalste breedte in zijn rij.
for (const { naam, rijen } of indelingen) {
  rijen.forEach((rij, nr) => {
    if (rij.slots.length < 2) return;
    const hoogtes = rij.slots.map(({ index, breedte }) => {
      const { width, height } = impressie.fotos[index].afbeelding;
      return (breedte * height) / width;
    });
    const verhouding = Math.min(...hoogtes) / Math.max(...hoogtes);
    if (verhouding < MIN_HOOGTEVERHOUDING) {
      console.warn(
        `[LandingImpressie] ${naam}, rij ${nr + 1}: laagste/hoogste foto = ${verhouding.toFixed(2)} (minimaal ${MIN_HOOGTEVERHOUDING}). Pas de breedtes van deze rij aan (som blijft 89vw), niet de volgorde.`,
      );
    }
  });
}

// ---- Indeling "rij": breedtes uit de beeldverhoudingen ----
interface RijFoto {
  foto: (typeof impressie.fotos)[number];
  /** Aandeel van de beschikbare breedte (de rij min de afstanden), tussen 0 en 1. */
  aandeel: number;
  /** Berekende breedte en hoogte in vw (voor `sizes` en de bewaking). */
  breedteVw: number;
  hoogteVw: number;
}

function berekenRij(hoogtes: number[], afstand: number): RijFoto[] {
  const fotos = impressie.fotos.slice(0, hoogtes.length);
  const gewichten = fotos.map((foto, i) => hoogtes[i] * (foto.afbeelding.width / foto.afbeelding.height));
  const som = gewichten.reduce((totaal, gewicht) => totaal + gewicht, 0);
  const beschikbaar = RIJ_BREEDTE_VW - (fotos.length - 1) * afstand;
  return fotos.map((foto, i) => {
    const aandeel = gewichten[i] / som;
    const breedteVw = aandeel * beschikbaar;
    return { foto, aandeel, breedteVw, hoogteVw: breedteVw / (foto.afbeelding.width / foto.afbeelding.height) };
  });
}

const afgerond = (x: number) => Math.round(x * 10) / 10;
const rijDesktop = indeling === 'rij' ? berekenRij(rijHoogtes, rijAfstandDesktop) : [];
const rijMobiel = indeling === 'rij' ? berekenRij(rijHoogtesMobiel, rijAfstandMobiel) : [];
const rijIndelingen = [
  { naam: 'desktop', afstand: rijAfstandDesktop, rij: rijDesktop },
  { naam: 'mobiel', afstand: rijAfstandMobiel, rij: rijMobiel },
].map(({ naam, afstand, rij }) => ({
  naam,
  afstand,
  fotos: rij.map((item, index) => ({
    foto: item.foto,
    aandeel: item.aandeel,
    sizes: `(min-width: 900px) ${afgerond(rijDesktop[index].breedteVw)}vw, ${afgerond(rijMobiel[index].breedteVw)}vw`,
  })),
}));

if (indeling === 'rij') {
  if (impressie.fotos.length !== rijHoogtes.length) {
    console.warn(
      `[LandingImpressie] indeling "rij" toont ${rijHoogtes.length} foto's, maar de data heeft er ${impressie.fotos.length}. Geef precies ${rijHoogtes.length} foto's.`,
    );
  }
  const hoogste = Math.max(...rijDesktop.map((item) => item.hoogteVw));
  if (hoogste > RIJ_MAX_HOOGTE_VW) {
    console.warn(
      `[LandingImpressie] indeling "rij": de hoogste foto is ${hoogste.toFixed(1)}vw hoog op desktop (richtlijn: ${RIJ_MAX_HOOGTE_VW}vw).`,
    );
  }
}
---

<section class="impressie" id="impressie" aria-labelledby={KOP_ID}>
  <h2 id={KOP_ID} class="visually-hidden">{impressie.titel}</h2>

  <div class="impressie__inhoud">
    {
      rijIndelingen.map(({ naam, afstand, fotos }) => (
        <div class={`impressie__rijen impressie__rijen--${naam}`} style={`--afstand: ${afstand}vw`}>
          <ul class="impressie__rij" role="list" style={`--uitlijning: ${rijUitlijning}`}>
            {fotos.map(({ foto, aandeel, sizes }, nr) => {
              const { width, height } = foto.afbeelding;
              return (
                <li
                  class="foto"
                  style={`--w: calc((100% - ${fotos.length - 1} * var(--afstand)) * ${aandeel.toFixed(5)}); --ratio: ${width} / ${height}; align-self: ${rijFotoUitlijning[nr] ?? rijUitlijning}; margin-bottom: ${rijFotoOmhoogVw[nr] ?? 0}vw`}
                >
                  <Picture
                    src={foto.afbeelding}
                    alt={foto.alt}
                    width={width}
                    height={height}
                    widths={WIDTHS}
                    sizes={sizes}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

    {
      (indeling === 'diagonaal' ? indelingen : []).map(({ naam, afstand, rijen }) => (
        <div class={`impressie__rijen impressie__rijen--${naam}`} style={`--afstand: ${afstand}vw`}>
          {rijen.map((rij) => (
            <ul class="impressie__rij" role="list" style={`--uitlijning: ${rij.uitlijning}`}>
              {rij.slots.map(({ index, breedte }) => {
                const foto = impressie.fotos[index];
                const { width, height } = foto.afbeelding;
                return (
                  <li class="foto" style={`--w: ${breedte}vw; --ratio: ${width} / ${height}`}>
                    <Picture
                      src={foto.afbeelding}
                      alt={foto.alt}
                      width={width}
                      height={height}
                      widths={WIDTHS}
                      sizes={`(min-width: 900px) ${breedteDesktop[index]}vw, ${breedteMobiel[index]}vw`}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      loading="lazy"
                      decoding="async"
                    />
                  </li>
                );
              })}
            </ul>
          ))}
        </div>
      ))
    }

    {
      impressie.link && (
        <p class="impressie__alle">
          <a class="impressie__alle-link" href={impressie.link.href}>
            <span class="impressie__alle-tekst">{impressie.link.label}</span>
            <svg
              class="impressie__pijl"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M3 12h17M14 5.5l6.5 6.5-6.5 6.5" />
            </svg>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  /* ---------- Impressie (mobiel eerst) ---------- */
  .impressie {
    --titel-size: clamp(1.25rem, 2vw, 2.5rem); /* grootte van de link, gelijk aan "alle series" in Projecten */
  }

  .impressie__inhoud {
    padding-inline: var(--gutter);
  }

  .impressie__rijen {
    display: flex;
    flex-direction: column;
    gap: var(--afstand); /* afstand tussen rijen, vanaf de onderkant van de hoogste foto erboven */
  }

  /* Eén indeling per breakpoint; de andere is display: none (staat na .impressie__rijen vanwege de volgorde). */
  .impressie__rijen--desktop {
    display: none;
  }

  /* Per rij van gutter tot gutter; de uitlijning (onderkanten of bovenkanten gelijk) komt uit de configuratie. */
  .impressie__rij {
    display: flex;
    flex-direction: row;
    align-items: var(--uitlijning);
    gap: var(--afstand);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Vaste breedte uit de configuratie. Mag een fractie krimpen (flex-shrink) als 100vw een scrollbalk bevat en de
     rij daardoor net iets smaller is dan 89vw; de verhouding blijft behouden. */
  .foto {
    flex: 0 1 var(--w);
    min-width: 0;
    margin: 0;
  }

  /* Eigen verhouding uit het bronbestand; hoogte volgt uit de breedte. */
  .foto :global(picture) {
    display: block;
  }

  .foto :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
  }

  /* Link: dezelfde stijl als "alle series" in Projecten, rechts op de gutter. */
  .impressie__alle {
    max-width: none;
    margin: 4vw 0 0; /* onder de laagste foto van de laatste rij (de rij is zo hoog als zijn hoogste foto) */
    text-align: right;
    font-size: var(--titel-size);
    line-height: 1.15;
  }

  .impressie__alle-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding-block: 0.4rem; /* raakvlak */
    text-decoration: none;
  }

  .impressie__alle-tekst {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .impressie__pijl {
    flex: none;
    width: 0.9em;
    height: 0.9em;
  }

  /* ---------- Impressie (desktop) ---------- */
  @media (min-width: 900px) {
    .impressie__rijen--mobiel {
      display: none;
    }

    .impressie__rijen--desktop {
      display: flex;
    }
  }
</style>
