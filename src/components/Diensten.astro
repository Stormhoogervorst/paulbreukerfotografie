---
/**
 * Sectie "Diensten": titelbalk (gedeelde Marquee) en een lijst met drie rijen.
 * Onafhankelijk van de buren: geen aannames over wat erboven of eronder staat.
 * Content: home.diensten in src/data/home.ts.
 */
import Marquee from './Marquee.astro';
import { home } from '../data/home';

const { titel, items } = home.diensten;
---

<section class="diensten" aria-labelledby="diensten-titel">
  <Marquee woord={titel} kopId="diensten-titel" />

  <div class="diensten__inhoud">
    <ul class="diensten__lijst">
      {
        items.map((dienst) => (
          <li>
            <a
              class="dienst"
              href={dienst.href}
              target={dienst.extern ? '_blank' : undefined}
              rel={dienst.extern ? 'noopener' : undefined}
            >
              <span class="dienst__nummer" aria-hidden="true">
                {dienst.nummer}
              </span>
              <span class="dienst__titel">
                {dienst.title}
                {dienst.extern && <span class="visually-hidden"> (opent in een nieuw tabblad)</span>}
              </span>
              {dienst.meta && <span class="dienst__meta">{dienst.meta}</span>}
              <svg
                class="dienst__pijl"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 48 14"
                width="48"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="butt"
                stroke-linejoin="miter"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M0 7h46M40 1l6 6-6 6" vector-effect="non-scaling-stroke" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ---------- Diensten (mobiel eerst) ---------- */
  /* Geen eigen buitenmarges: de verticale ruimte komt van de .sectie-wrapper in index.astro. */
  .diensten__inhoud {
    padding-inline: var(--gutter);
  }

  /* Elke rij is één link over de volle breedte van de li. Lijn onder elke rij, geen lijn boven de eerste. */
  .dienst {
    --rij-size: clamp(1.5rem, 6vw, 2rem);
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    width: 100%;
    min-height: 56px; /* raakvlak */
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    text-decoration: none;
    font-size: var(--rij-size);
    font-weight: 400;
    line-height: 1;
  }

  .dienst__nummer {
    grid-column: 1;
    grid-row: 1;
  }

  .dienst__titel {
    grid-column: 2;
    grid-row: 1;
  }

  /* Mobiel: de meta staat klein onder de titel. */
  .dienst__meta {
    grid-column: 2;
    grid-row: 2;
    margin-top: 0.5rem;
    font-size: var(--font-size-small);
    line-height: 1.2;
  }

  .dienst__pijl {
    grid-column: 3;
    grid-row: 1 / span 2;
    justify-self: end;
    width: 1.75rem;
    height: auto;
    margin-inline-start: 1rem;
  }

  /* Geen hoverinversie op touch; wel een lichte actieve staat. */
  .dienst:active {
    background: rgb(21 21 21 / 0.06);
  }

  /* Zichtbare focus: de rij wordt zwart met lichte tekst; de focusring staat 3px buiten de balk. */
  .dienst:focus-visible {
    position: relative;
    z-index: 1;
    background: var(--ink);
    color: var(--paper);
    outline: 3px solid var(--ink);
    outline-offset: 3px;
    border-radius: 0;
  }

  /* ---------- Diensten (desktop) ---------- */
  @media (min-width: 900px) {
    .dienst {
      --rij-size: clamp(1.75rem, 3.3vw, 4.5rem);
      grid-template-columns: 18.5% 1fr auto auto;
      min-height: 0;
      padding-block: clamp(1.25rem, 2.2vw, 3rem);
    }

    /* Vaste kolommen, ook als de meta ontbreekt. */
    .dienst__nummer {
      grid-column: 1;
      grid-row: 1;
      padding-inline-start: 0;
    }

    .dienst__titel {
      grid-column: 2;
      grid-row: 1;
    }

    .dienst__meta {
      grid-column: 3;
      grid-row: 1;
      margin: 0 2rem 0 0;
      font-size: clamp(1rem, 1.1vw, 1.375rem);
      text-align: right;
    }

    .dienst__pijl {
      grid-column: 4;
      grid-row: 1;
      width: clamp(1.5rem, 1.8vw, 3rem);
      margin-inline: 0 1.4vw; /* ongeveer 1,6% van de lijstbreedte (89vw) */
    }

    /* Hover alleen waar er echt een aanwijzer is. Het nummer schuift op, de titelkolom blijft staan. */
    @media (hover: hover) {
      .dienst:hover {
        background: var(--ink);
        color: var(--paper);
      }

      .dienst:hover .dienst__nummer {
        padding-inline-start: 1.7vw;
      }
    }

    .dienst:focus-visible .dienst__nummer {
      padding-inline-start: 1.7vw;
    }

    @media (prefers-reduced-motion: no-preference) {
      .dienst {
        transition:
          background-color 200ms ease,
          color 200ms ease;
      }

      .dienst__nummer {
        transition: padding-inline-start 200ms ease;
      }
    }
  }
</style>
