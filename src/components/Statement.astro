---
/**
 * Statement: haarlijn bovenaan, links een klein label tussen haakjes, rechts grote lopende tekst met een ingesprongen
 * eerste regel, daaronder een kleine link. Gebruikt door de homepage-sectie "(over paul)" (OverPaul.astro) en door de
 * landingspagina-sectie "Werkwijze" (LandingLayout.astro).
 *
 * Geen eigen buitenmarges: de verticale ruimte komt van de .sectie-wrapper om de component heen.
 * Toegankelijkheid: standaard is het label een <p> en krijgt de sectie `aria-label`. Met `labelAlsKop` is het label de
 * <h2> van de sectie (homepage "(over paul)") en verwijst `aria-labelledby` ernaar.
 *
 * Optioneel `foto`: kleine foto onder het label, in dezelfde linkerkolom en links op één lijn met het label (alleen
 * homepage "(over paul)"). Zonder `foto` is de opmaak en de HTML ongewijzigd.
 */
import { Picture } from 'astro:assets';
import { BREEDTES_PAUL, FALLBACK_FORMAAT, FORMATEN } from '../lib/beeld';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Klein label links, bijvoorbeeld "(werkwijze)". */
  label: string;
  /** Lopende tekst rechts. Eén alinea of meerdere (elke string een <p>). */
  tekst: string | string[];
  link?: { label: string; href: string };
  /** Toegankelijke naam van de sectie. Verplicht zolang het label geen kop is. */
  ariaLabel?: string;
  /** Label als <h2> in plaats van <p>. Dan is `id` verplicht. */
  labelAlsKop?: boolean;
  /** id van het label, voor `aria-labelledby` (alleen bij `labelAlsKop`). */
  id?: string;
  /** Kleine foto onder het label (bronbestand met vaste width/height; nooit breder dan het bronbestand). */
  foto?: { afbeelding: ImageMetadata; alt: string };
  /** Mobiel (onder 900 px): alinea's uitgevuld, zonder inspringing en met afbreken. Desktop blijft ongewijzigd. */
  uitgevuldOpMobiel?: boolean;
  /** Desktop (vanaf 900 px): iets kleinere tekst dan de standaard van Statement. Mobiel blijft ongewijzigd. */
  kleinerOpDesktop?: boolean;
}

const { label, tekst, link, ariaLabel, labelAlsKop = false, id, foto, uitgevuldOpMobiel = false, kleinerOpDesktop = false } = Astro.props;
const alineas = Array.isArray(tekst) ? tekst : [tekst];
const Label = labelAlsKop ? 'h2' : 'p';

if (labelAlsKop && !id) throw new Error('Statement: `id` is verplicht bij `labelAlsKop`.');
if (!labelAlsKop && !ariaLabel) throw new Error('Statement: `ariaLabel` is verplicht zolang het label geen kop is.');
---

<section
  class:list={['statement', { 'statement--uitgevuld': uitgevuldOpMobiel, 'statement--kleiner': kleinerOpDesktop }]}
  aria-labelledby={labelAlsKop ? id : undefined}
  aria-label={labelAlsKop ? undefined : ariaLabel}
>
  <div class="statement__inner">
    {
      foto ? (
        <div class="statement__kop">
          <Label id={labelAlsKop ? id : undefined} class="statement__label statement-label">
            {label}
          </Label>
          <Picture
            class="statement__foto"
            src={foto.afbeelding}
            alt={foto.alt}
            width={foto.afbeelding.width}
            height={foto.afbeelding.height}
            widths={BREEDTES_PAUL}
            sizes="(min-width: 700px) min(9vw, 10rem), 20vw"
            formats={FORMATEN}
            fallbackFormat={FALLBACK_FORMAAT}
            loading="lazy"
            decoding="async"
          />
        </div>
      ) : (
        <Label id={labelAlsKop ? id : undefined} class="statement__label statement-label">
          {label}
        </Label>
      )
    }

    <div class="statement__body">
      {alineas.map((alinea) => (
        <p class="statement__tekst statement-tekst">{alinea}</p>
      ))}
      {
        link && (
          <a class="statement__link statement-link" href={link.href}>
            {link.label} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  /* ---------- Statement (mobiel eerst) ---------- */
  /* Lettertype-eigenschappen van label, tekst en link staan in global.css (.statement-label, .statement-tekst,
     .statement-link), gedeeld met LandingOverPaul. Hier alleen plaatsing. */
  .statement {
    --tekst-size: var(--statement-tekst-size);
    /* Geen eigen buitenmarges: de verticale ruimte komt van de .sectie-wrapper om de component heen. */
    padding: 0 var(--gutter);
  }

  /* Dunne lijn over de volle breedte binnen de marges (dezelfde als header en hero). */
  .statement__inner {
    padding-top: var(--statement-boven);
    border-top: var(--haarlijn);
  }

  .statement__label {
    margin: 0 0 var(--space-4);
  }

  .statement__tekst + .statement__tekst {
    margin-top: 0.6em;
  }

  .statement__link {
    margin-top: calc(2rem - 0.4rem);
  }

  /* Label + foto (alleen met `foto`). Mobiel: label, 4vw, foto (20vw, links), 6vw, tekst. De foto wordt nooit breder
     dan het bronbestand en nooit bijgesneden (hoogte volgt uit de verhouding). Geen rand, schaduw, filter of hover. */
  .statement__kop {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 6vw;
  }

  .statement__kop .statement__label {
    margin: 0;
  }

  .statement__foto {
    display: block;
    width: min(20vw, 100%);
    max-width: 400px;
    height: auto;
    margin-top: 4vw;
  }

  @media (min-width: 700px) {
    .statement__foto {
      width: min(9vw, 10rem);
      margin-top: 2vw;
    }
  }

  /* Zachte fade bij verschijnen in beeld. Alleen waar scroll-gestuurde animatie bestaat,
     en nooit bij prefers-reduced-motion. Zonder ondersteuning staat de tekst gewoon zichtbaar. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement__inner {
        animation: statement-fade linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }

      @keyframes statement-fade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
    }
  }

  /* Alleen met `uitgevuldOpMobiel` en alleen onder het desktop-breakpoint (900 px): nette, uitgevulde alinea's van
     rand tot rand. lang="nl" staat op <html> (BaseLayout), dus hyphens: auto breekt Nederlandse woorden goed af.
     text-wrap: wrap zet de "pretty"-regelbreking uit, zodat de regels vanzelf doorlopen (geen losse laatste woorden). */
  @media (max-width: 899px) {
    .statement--uitgevuld .statement__tekst {
      font-size: 1.125rem;
      line-height: 1.5;
      text-align: justify;
      text-indent: 0;
      -webkit-hyphens: auto;
      hyphens: auto;
      text-wrap: wrap;
    }

    .statement--uitgevuld .statement__tekst + .statement__tekst {
      margin-top: 0;
    }

    .statement--uitgevuld .statement__tekst {
      margin-bottom: 1em;
    }

    .statement--uitgevuld .statement__tekst:last-of-type {
      margin-bottom: 0;
    }
  }

  /* ---------- Statement (desktop) ---------- */
  @media (min-width: 900px) {
    /* Kleinere tekst (standaard: clamp(1.75rem, 2.8vw, 4rem)). Label- en fotopositie rekenen mee via --tekst-size. */
    .statement--kleiner {
      --statement-tekst-size: clamp(1.5rem, 2.3vw, 3.25rem);
    }

    .statement__inner {
      display: grid;
      grid-template-columns: var(--statement-kolommen);
      column-gap: var(--gutter);
    }

    /* Bovenkant van het label op de bovenkant van de eerste tekstregel. */
    .statement__label {
      align-self: start;
      margin: 0;
      padding-top: calc(var(--tekst-size) * 0.18);
    }

    /* Met foto: label en foto samen in de linkerkolom. De kolom is net zo hoog als de tekst rechts: het label staat
       bovenaan, de onderkant van de foto op de basislijn van de laatste tekstregel (de regelruimte onder de laatste
       regel, ongeveer 0,21 × de tekstgrootte, telt niet mee). De tekst rechts verandert niet. */
    .statement__kop {
      align-self: stretch;
      justify-content: space-between;
      margin-bottom: calc(var(--tekst-size) * 0.21);
    }
  }
</style>
