---
/**
 * Foto uit src/assets/home/ via <Picture> (AVIF + WebP + JPEG-fallback).
 * Ontbreekt het bestand, dan komt er een neutraal blok met dezelfde verhouding
 * en een TODO(paul), zodat de build niet faalt en de layout niet verspringt.
 *
 * `width` en `height` bepalen de uitsnede en verhouding (fit: cover), ongeacht het
 * formaat van het bronbestand. `fill` laat het blok de hoogte van de ouder volgen.
 */
import { Picture } from 'astro:assets';
import { getHomeImage } from '../lib/images';

interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  sizes: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  fill?: boolean;
  /** Welk deel van de bron blijft staan bij het bijsnijden: 'top', 'center', 'left top', enz. */
  position?: 'top' | 'bottom' | 'left' | 'right' | 'center' | 'left top' | 'right top' | 'left bottom' | 'right bottom';
}

const {
  name,
  alt,
  width,
  height,
  sizes,
  widths = [320, 480, 640, 800],
  loading = 'lazy',
  fetchpriority,
  fill = false,
  position = 'center',
} = Astro.props;

const image = getHomeImage(name);
---

<div class:list={['photo', { 'photo--fill': fill }]} style={`--ratio: ${width} / ${height}`}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        width={width}
        height={height}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        fit="cover"
        position={position}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={loading === 'eager' ? 'sync' : 'async'}
      />
    ) : (
      <div class="photo__placeholder">
        <p>
          TODO(paul): foto <code>{name}</code> ontbreekt
        </p>
      </div>
    )
  }
</div>

<style>
  .photo {
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: #f2f2f2;
  }

  .photo--fill {
    aspect-ratio: auto;
    height: 100%;
  }

  .photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: var(--space-3);
    border: 1px dashed var(--ink);
    color: var(--ink);
    font-size: var(--font-size-small);
    text-align: center;
  }

  .photo__placeholder p {
    margin: 0;
  }
</style>
