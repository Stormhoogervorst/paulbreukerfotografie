---
/**
 * /portfolio: alle foto's op één oneindig, sleepbaar canvas (beleving, lage SEO-prioriteit).
 * Het zoekmachinevriendelijke overzicht van de series is /series.
 * Data: src/data/portfolio.ts. Canvas (markup, CSS, lightbox): src/components/canvas/FotoCanvas.astro, gedeeld met
 * /portfolio/portretten. Layout: src/lib/portfolio-layout.ts. Gedrag: src/scripts/foto-canvas.ts.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FotoCanvas from '../components/canvas/FotoCanvas.astro';
import { portfolio } from '../data/portfolio';
import { getPortfolioImages } from '../lib/portfolio-images';
import { breadcrumbList, fotoCollectie } from '../lib/schema';
import type { CanvasConfig } from '../scripts/foto-canvas';

/**
 * Met ruim 300 foto's: op mobiel laden de foto's in de marge rond het eerste scherm pas bij de eerste aanraking (de eerste
 * laadronde blijft klein; wat in beeld komt, laadt vanzelf). Cellen en rest van het gedrag zijn de standaardwaarden van het canvas.
 */
const config: CanvasConfig = { holdMarginMobile: true };

// Deelafbeelding (1200 × 630, JPEG: Open Graph kent geen AVIF): eerste liggende foto uit Love & Marriage, anders de eerste foto.
const ogIndex = Math.max(
  0,
  portfolio.findIndex((photo) => photo.series === 'love-marriage' && photo.width > photo.height),
);
const ogBron = portfolio.length ? portfolio[ogIndex].image : undefined;
const ogImage = ogBron
  ? (
      await getImage({
        // Een externe afbeelding (RemoteImage, zie src/data/portfolio.ts) gaat op `src` (URL) in plaats van als metadata.
        src: 'format' in ogBron ? (ogBron as ImageMetadata) : ogBron.src,
        width: 1200,
        height: 630,
        fit: 'cover',
        format: 'jpg',
        quality: 80,
      })
    ).src
  : undefined;

const title = 'Portfolio | Paul Breuker: bruiloften, portretten en series';
const description =
  'Verken het werk van fotograaf Paul Breuker in één oneindig canvas: bruiloften, portretten en kunstseries. Sleep en klik voor een groot formaat.';

// JSON-LD: de ImageGallery bevat maximaal de eerste 30 foto's (de pagina toont ze allemaal).
const SCHEMA_MAX = 30;
const schemaFotos = await Promise.all(
  portfolio.slice(0, SCHEMA_MAX).map(async (foto) => {
    const { large } = await getPortfolioImages(foto);
    const groot = large[large.length - 1];
    return {
      url: groot.src,
      name: foto.alt,
      width: groot.width,
      height: Math.round((groot.width * foto.height) / foto.width),
      creditText: 'Paul Breuker',
      copyrightNotice: '© Paul Breuker',
    };
  }),
);
---

<FotoCanvas
  title={title}
  description={description}
  canonical="/portfolio"
  ogImage={ogImage}
  jsonLd={[
    breadcrumbList([
      { name: 'Home', path: '/' },
      { name: 'Portfolio', path: '/portfolio' },
    ]),
    fotoCollectie({
      name: 'Portfolio',
      description,
      path: '/portfolio',
      totaal: portfolio.length,
      images: schemaFotos,
    }),
  ]}
  fotos={portfolio}
  h1="Portfolio"
  instructie="Sleep om te verkennen. Klik op een foto voor groot formaat."
  terug={[{ label: 'home', href: '/' }]}
  links={[
    { label: 'Alle series', href: '/series' },
    { label: 'Bruiloften', href: '/portfolio/bruiloften' },
    { label: 'Portretten', href: '/portfolio/portretten' },
    { label: 'Contact', href: '/contact' },
  ]}
  config={config}
  bron="html"
  lijstLabel="Alle foto's"
/>
