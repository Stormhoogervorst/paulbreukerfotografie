---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import OverPaul from '../components/OverPaul.astro';
import Diensten from '../components/Diensten.astro';
import BeeldDuo from '../components/BeeldDuo.astro';
import Exposities from '../components/Exposities.astro';
import Panorama from '../components/Panorama.astro';
import Projecten from '../components/Projecten.astro';
import { home } from '../data/home';
import { localBusiness } from '../lib/schema';
import { CONTACT, SAME_AS } from '../data/site';

const jsonLd = [
  localBusiness({
    type: 'ProfessionalService',
    telephone: CONTACT.phoneHref.replace('tel:', ''),
    email: CONTACT.email || undefined,
    address: home.schema.address,
    areaServed: home.schema.areaServed,
    sameAs: SAME_AS,
  }),
];

// H1 is alleen de naam. Op mobiel staat elk woord op een eigen regel.
const titleWords = home.hero.h1.split(' ');

// Hero-foto's op rol: A (groot, LCP), B (middel, liggend), C (klein, staand).
const heroFoto = (rol: 'A' | 'B' | 'C') => {
  const foto = home.hero.fotos.find((f) => f.rol === rol);
  if (!foto) throw new Error(`home.hero.fotos mist de foto met rol ${rol}`);
  return foto;
};
const fotoA = heroFoto('A');
const fotoB = heroFoto('B');
const fotoC = heroFoto('C');
---

<BaseLayout title={home.seo.title} description={home.seo.description} jsonLd={jsonLd}>
  <!--
    VOLGORDE HOMEPAGE (bindend, zie .cursor/rules/paulbreuker-regels.mdc):
    1. Hero
    2. OverPaul
    3. Projecten
    4. Diensten
    5. BeeldDuo
    6. Exposities
    7. Panorama (foto van rand tot rand, geen kop)
    Daarna volgt later een CTA (bestaat nog niet). Wijzig deze volgorde alleen op uitdrukkelijk verzoek.
    Elke sectie staat in een .sectie-wrapper (alleen padding-block, geen horizontale padding, zodat de
    marquee's full-bleed blijven). Secties hebben zelf geen buitenmarges.
    Vorige versie: design/archief/index-vorige-versie.astro.txt
  -->
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title" class="hero__title">
      {titleWords.map((word, index) => <><span>{word}</span>{index < titleWords.length - 1 ? ' ' : ''}</>)}
    </h1>

    <div class="hero__media">
      <div class="hero__photo hero__photo--a">
        <!-- Het hero-beeld is het LCP-beeld, staand (2:3) en ongecropt. `sizes` zonder var(): die wordt in dit attribuut niet ondersteund (5,5vw = --gutter). -->
        <!-- Vanaf 900 px is dit blok 4 / 5 (CSS snijdt de staande bron bij); de gegenereerde afbeelding blijft 2:3 zodat mobiel ongewijzigd is. -->
        <Photo
          name={fotoA.afbeelding}
          alt={fotoA.alt}
          width={1200}
          height={1800}
          widths={[320, 480, 800, 1200]}
          sizes="(min-width: 900px) 25vw, calc(100vw - 11vw)"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- B en C: alleen vanaf 900 px (daaronder display: none; lazy, dus geen download). Decoratieve opstelling zonder bijschrift. -->
      <div class="hero__photo hero__photo--b">
        <Photo
          name={fotoB.afbeelding}
          alt={fotoB.alt}
          width={1000}
          height={800}
          widths={[240, 400, 640, 960]}
          sizes="(min-width: 900px) 14vw, 1px"
          loading="lazy"
          fetchpriority="low"
          position="left"
        />
      </div>
      <div class="hero__photo hero__photo--c">
        <Photo
          name={fotoC.afbeelding}
          alt={fotoC.alt}
          width={800}
          height={1000}
          widths={[200, 320, 480, 800]}
          sizes="(min-width: 900px) 13vw, 1px"
          loading="lazy"
          fetchpriority="low"
        />
      </div>

      <div class="hero__text">
        <p class="hero__lead">{home.hero.lead}</p>
        <p class="hero__knop-rij">
          <a class="hero__knop" href={home.hero.knop.href}>
            {home.hero.knop.label} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </div>
  </section>

  <div class="sectie sectie--na-hero">
    <OverPaul />
  </div>
  <div class="sectie">
    <Projecten />
  </div>
  <div class="sectie">
    <Diensten />
  </div>
  <div class="sectie sectie--compact">
    <BeeldDuo />
  </div>
  <div class="sectie">
    <Exposities />
  </div>
  <div class="sectie sectie--panorama">
    <Panorama />
  </div>
</BaseLayout>

<style>
  /* ---------- Sectie-wrapper ---------- */
  /* Alleen padding-block: de ruimte tussen twee secties is de som van twee halve waarden, ongeacht de volgorde.
     Bewust geen horizontale padding of marge: de marquee's lopen van rand tot rand. */
  .sectie {
    padding-block: calc(var(--sectie-ruimte) / 2);
  }

  /* Het panorama van rand tot rand sluit onderaan direct aan op de footer: geen ruimte eronder. */
  .sectie--panorama {
    padding-bottom: 0;
  }

  /* Fotospread zit dichter op zijn buren. */
  .sectie--compact {
    --sectie-ruimte: clamp(4rem, 8vw, 10rem);
  }

  /* Mobiel: extra witruimte boven "Over Paul", bovenop de 8vh onder de hero-foto. */
  .sectie--na-hero {
    padding-top: 8rem;
  }

  /* Desktop: alleen de eigen ruimte van de hero (8vh onder de foto): geen dubbele ruimte. */
  @media (min-width: 900px) {
    .sectie--na-hero {
      padding-top: 0;
    }
  }

  /* ---------- Hero (mobiel eerst) ---------- */
  .hero {
    /* Mobiel vult "Breuker" (het langste woord, 3,29em ink) de breedte binnen de marges (89vw). */
    --wordmark-size: 27vw;
    --overlap: 0.13; /* deel van het wordmark (in em) dat de foto overlapt */
    position: relative;
    padding: var(--space-5) var(--gutter) 8vh;
    overflow-x: clip;
  }

  .hero__title {
    position: relative;
    z-index: 2; /* wordmark staat boven de foto */
    margin: 0 0 0 -0.081em; /* linkerzijbeen van de P (0,081em) op de tekstmarge */
    font-size: var(--wordmark-size);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--ink);
    white-space: nowrap;
  }

  .hero__title span {
    display: block;
  }

  .hero__media {
    position: relative;
    margin-top: calc(var(--wordmark-size) * var(--overlap) * -1);
  }

  /* Binnen de marges: de linkerrand van de foto ligt op de gutter, op één lijn met de linkerkant van de H1 (de P). */
  .hero__photo {
    width: 100%;
    margin-left: 0;
  }

  /* B en C: alleen vanaf 900 px (zie desktop-blok). */
  .hero__photo--b,
  .hero__photo--c {
    display: none;
  }

  .hero__text {
    margin-top: var(--space-4);
  }

  .hero__lead {
    max-width: 28ch;
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-body);
    line-height: 1.1;
  }

  .hero__knop-rij {
    max-width: none;
    margin: 0;
  }

  /* Tekstlink met streep eronder en pijltje, zoals de vorige links. */
  .hero__knop {
    display: inline-block;
    padding-block: 0.4rem; /* raakvlak */
    font-size: var(--font-size-body);
    line-height: 1.1;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .hero__knop:hover {
    text-decoration-thickness: 2px;
  }

  /* Zachte fade van de hero-tekst bij laden. Niet op het wordmark of de foto (LCP). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__text {
      animation: hero-fade 0.9s ease-out both;
    }

    @keyframes hero-fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  }

  /* ---------- Hero (desktop) ---------- */
  @media (min-width: 900px) {
    .hero {
      /* "Paul Breuker" is 5,363em ink breed (P-vorm tot r-vorm) bij -0,04em letter-spacing. Het font-size is
         de breedte tussen de twee gutters gedeeld door die 5,363em: fluïde en zonder maximum, dus de vorm van de
         P ligt op de linkergutter en de vorm van de r op de rechtergutter, op elke breedte vanaf 900px. */
      --wordmark-ink: 5.363;
      --wordmark-size: calc(var(--wordmark-width) / var(--wordmark-ink));
      --overlap: 0.2;
      /* Ruimte voor foto B boven het wordmark. B steekt boven de header-rand uit, de lege strook onder de
         contactgegevens in (zie .hero__photo--b). De bovenkant van B ligt 2vw onder de contactgegevens
         (die eindigen 7,5rem boven de onderkant van de header: de hoogte van het menu is vast in px);
         B is 10,4vw hoog en blijft 2,5vw boven de letters. Dat geeft 14,9vw - 7,5rem - 0,063em
         (0,063em = bovenkant titelregel tot letters). Minimaal 3vw, zodat het wordmark niet tegen het menu zit.
         15,72vw = 2vw + 2,6vw (2,5vw plus marge voor de bovenhoogte van l/k/B) + B-hoogte (13,9vw * 4/5 = 11,12vw). */
      padding-top: max(3vw, calc(15.72vw - 7.5rem - var(--wordmark-size) * 0.063));
    }

    .hero__title span {
      display: inline;
    }

    /* Zigzag rond het wordmark. Alle maten in vw (de verhoudingen schalen mee, geen layoutverschuiving).
       T = bovenkant van A (en van hero__media). Gemeten voor Satoshi 700, in em van het wordmark:
       letters beginnen 0,587em boven T, de basislijn (geen staarten) ligt 0,157em onder T.
       Het wordmark loopt van gutter tot gutter (89vw bij 5,5vw gutter; voorheen 83vw). Alle foto's zijn met dezelfde
       factor (89/83 = 1,072) meegeschaald, zodat de verhoudingen van de zigzag gelijk blijven.
       - A: 24,3vw breed, 4 / 5, links op de gutter (op één lijn met de linkerkant van de H1), overlapt het wordmark in dezelfde verhouding als voorheen.
       - B: 13,9vw breed, 5 / 4, gecentreerd boven "reu" van Breuker (die staat nu op 48,7 tot 72vw: B links op 53,2vw),
         onderkant 2,5vw boven de letters van het wordmark.
       - C: 12,9vw breed, 4 / 5, rechterrand op de rechtergutter (= rechterrand van de r en van de navigatie),
         bovenkant 2,2vw onder de basislijn.
       - Alinea: links op dezelfde 53,2vw als B, 23,6vw breed, onderkant gelijk aan de onderkant van C. */
    .hero__media {
      --foto-a: 24.3vw;
      --foto-b: 13.9vw;
      --foto-b-links: 53.2vw;
      --foto-c: 12.9vw;
      --foto-a-hoogte: calc(var(--foto-a) * 5 / 4);
      --foto-b-hoogte: calc(var(--foto-b) * 4 / 5);
      --foto-c-hoogte: calc(var(--foto-c) * 5 / 4);
      --letters-boven-t: calc(var(--wordmark-size) * 0.587);
      --basislijn-onder-t: calc(var(--wordmark-size) * 0.157);
      --foto-c-top: calc(var(--basislijn-onder-t) + 2.3vw); /* 2,3vw: de ronde letters steken iets onder de basislijn uit */
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      /* A staat lager: de bovenkant ligt 7vw onder de bovenkant van C (die zelf onder het wordmark staat),
         afmetingen ongewijzigd. Pas --foto-a-zak aan om A hoger of lager te zetten. */
      --foto-a-zak: calc(var(--foto-c-top) + 7vw);
      min-height: calc(var(--foto-a-zak) + var(--foto-a-hoogte));
    }

    .hero__photo--a {
      grid-area: 1 / 1;
      width: var(--foto-a);
      margin-top: var(--foto-a-zak); /* links op de gutter, op één lijn met de H1 */
    }

    .hero__photo--a :global(.photo) {
      aspect-ratio: 4 / 5; /* de bron is 2:3: object-fit snijdt bij, alleen op desktop */
    }

    .hero__photo--b,
    .hero__photo--c {
      display: block;
      position: absolute;
      margin-left: 0;
    }

    .hero__photo--b {
      width: var(--foto-b);
      top: calc(-1 * (var(--letters-boven-t) + 2.6vw + var(--foto-b-hoogte)));
      left: calc(var(--foto-b-links) - var(--gutter));
      z-index: 21; /* boven de header (z-index 20, eigen achtergrond): B staat deels in de lege strook van de header */
    }

    .hero__photo--c {
      width: var(--foto-c);
      top: var(--foto-c-top);
      /* rechterrand op de rechtergutter: hero__media begint op de linkergutter, dus de breedte tussen de gutters minus C */
      left: calc(var(--wordmark-width) - var(--foto-c));
    }

    .hero__text {
      grid-area: 1 / 1;
      align-self: end;
      justify-self: start;
      /* Onderkant gelijk aan de onderkant van C (de onderstreping van de link, vandaar de 0,2rem). Boven de alinea
         blijft minstens de ruimte tot de basislijn van het wordmark + 2,2vw; is de tekst hoger (smaller scherm,
         meer regels), dan groeit de rij naar beneden in plaats van dat de alinea het wordmark raakt. */
      margin: var(--foto-c-top) 0
        calc(var(--foto-a-zak) + var(--foto-a-hoogte) - var(--foto-c-top) - var(--foto-c-hoogte) - 0.2rem)
        calc(var(--foto-b-links) - var(--gutter));
      width: 23.6vw;
    }

    /* Onder 1200 px past de alinea (meer regels) niet tussen de basislijn en de onderkant van C:
       dan onderaan gelijk aan A, zodat de rij niet onnodig hoger wordt. */
    @media (max-width: 1199px) {
      .hero__text {
        margin-bottom: -0.2rem;
      }
    }

    .hero__lead {
      max-width: none;
    }
  }
</style>
