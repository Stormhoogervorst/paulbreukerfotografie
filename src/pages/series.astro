---
/**
 * /series: overzicht van Pauls projecten. Vaste opbouw: header, H1 "Series" (PaginaKop) met een korte tekst ernaast
 * (eronder op smalle schermen), raster met kaarten, footer.
 * Geen filters, geen andere secties. Data en volgorde: src/data/series.ts.
 * Elk blok zit in een eigen wrapper met alleen padding; geen margins die van buren afhangen.
 */
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PaginaKop from '../components/PaginaKop.astro';
import Segmenten from '../components/Segmenten.astro';
import { serieLijst, serieHref } from '../data/series';
import { breadcrumbList, collectionPage } from '../lib/schema';
import { BREEDTES_KAART, FALLBACK_FORMAAT, FORMATEN } from '../lib/beeld';
import { linkSegmenten } from '../lib/segmenten';

/** Letterlijk deze zin; alleen het woord "contact" is een link (linkSegmenten). */
const inleiding = linkSegmenten(
  'Onderstaande series zijn bijna allemaal uitgegeven in boekvorm. Boek bestellen? Neem dan contact met mij op.',
  [{ tekst: 'contact', href: '/contact' }],
);

const title = 'Fotoseries en projecten | Paul Breuker';
const description =
  'Mijn fotoseries en projecten: Love & Marriage, Take me to the river, De Gaarkeuken en meer. Portret, reportage en kunst door Paul Breuker.';

const jsonLd = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Series', path: '/series' },
  ]),
  collectionPage({
    name: 'Series',
    description,
    path: '/series',
    items: serieLijst.map((project) => ({ name: project.titel, path: serieHref(project.slug) })),
  }),
];

---

<BaseLayout title={title} description={description} canonical="/series" jsonLd={jsonLd}>
  <PaginaKop titel="Series">
    <p slot="intro" class="series-inleiding">
      <Segmenten segmenten={inleiding} />
    </p>
  </PaginaKop>

  <div class="series-raster">
    <ul class="series-raster__lijst" role="list">
      {
        serieLijst.map((project, index) => (
          <li class="kaart">
            <a class="kaart__link" href={serieHref(project.slug)}>
              <span class="kaart__beeld">
                <Picture
                  src={project.omslag}
                  alt={project.alt}
                  width={project.omslag.width}
                  height={project.omslag.height}
                  widths={BREEDTES_KAART}
                  sizes="(min-width: 700px) 46vw, 89vw"
                  formats={FORMATEN}
                  fallbackFormat={FALLBACK_FORMAAT}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : undefined}
                  decoding="async"
                  class="kaart__foto"
                />
              </span>
              <h2 class="kaart__titel">{project.titel}</h2>
              {project.onderregel && <p class="kaart__onderregel">{project.onderregel}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  /* De H1 staat in PaginaKop.astro, gedeeld met /contact. De inleiding staat in het slot: onder 768px onder de H1
     (ook als de kaarten vanaf 700px al twee kolommen zijn), daarboven rechts op de linkerrand van de rechterkolom. */

  .series-inleiding {
    max-width: none;
    margin: clamp(0.75rem, 2vw, 1.25rem) 0 0;
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: var(--intro-lh);
    letter-spacing: 0;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  /* Zelfde tekstlink als elders in lopende tekst: streep, dikker bij hover, focus zoals de kaarten op deze pagina. */
  .series-inleiding :global(a) {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .series-inleiding :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  .series-inleiding :global(a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 0;
  }

  /* ---------- Raster (mobiel: één kolom) ---------- */
  .series-raster {
    padding: 0 var(--gutter) var(--sectie-ruimte);
  }

  .series-raster__lijst {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Kaart ---------- */
  /* De ruimte tussen twee kaarten is de margin-top van de onderste kaart; de eerste kaart van een kolom heeft er
     geen (de bovenste kaarten staan op één lijn). */
  .kaart {
    min-width: 0;
    margin-top: 8vw;
    break-inside: avoid;
  }

  .kaart:first-child {
    margin-top: 0;
  }

  .kaart__link {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }

  /* Eigen beeldverhouding uit width/height van het bronbestand: niet croppen, geen vaste hoogte.
     De wrapper volgt die maat en clipt alleen de hover-zoom; titel en onderregel staan erbuiten. */
  .kaart__beeld {
    display: block;
    overflow: hidden;
  }

  .kaart__beeld :global(.kaart__foto) {
    display: block;
    width: 100%;
    height: auto;
  }

  .kaart__titel {
    margin: max(0.5rem, 1vw) 0 0;
    font-size: max(1.125rem, 2vw);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0;
  }

  .kaart__onderregel {
    max-width: none;
    margin: 0.25em 0 0;
    font-size: max(1rem, 1.5vw);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-gedempt);
  }

  .kaart__link:hover .kaart__titel {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .kaart__link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 0;
  }

  /* Zoom alleen bij een echte muis. will-change pas tijdens hover/focus, niet op alle kaarten tegelijk. */
  @media (hover: hover) and (pointer: fine) {
    .kaart__beeld :global(.kaart__foto) {
      transition: transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .kaart__link:hover .kaart__beeld :global(.kaart__foto),
    .kaart__link:focus-visible .kaart__beeld :global(.kaart__foto) {
      transform: scale(1.04);
      will-change: transform;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kaart__beeld :global(.kaart__foto),
    .kaart__link:hover .kaart__beeld :global(.kaart__foto),
    .kaart__link:focus-visible .kaart__beeld :global(.kaart__foto) {
      transition: none;
      transform: none;
      will-change: auto;
    }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 700px) {
    /* Twee kolommen waarin de kaarten direct op elkaar aansluiten (met 4vw witruimte ertussen), ongeacht de hoogte van
       de foto's. De browser verdeelt de kaarten zo gelijk mogelijk over de kolommen; de volgorde loopt per kolom van
       boven naar beneden (eerst de linkerkolom, dan de rechter). */
    .series-raster__lijst {
      column-count: 2;
      column-gap: 1.7vw;
    }

    .kaart {
      margin-top: 4vw;
    }

    .kaart:first-child {
      margin-top: 0;
    }
  }

  /* Desktop: naast de H1, uitgelijnd op de rechterkolom. Onder 768px blijft de tekst onder de H1. */
  @media (min-width: 768px) {
    /* Zelfde kolommen als het raster (1fr / 1fr, gap 1.7vw), binnen dezelfde gutter. De tekst sluit met de basislijn
       van de laatste regel aan op de basislijn van de H1 en wordt niet breder dan de rechterkolom. */
    :global(.pagina-kop--met-intro) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.7vw;
      align-items: last baseline;
    }

    .series-inleiding {
      min-width: 0;
      max-width: min(34rem, 100%);
      margin: 0;
      justify-self: start;
    }
  }
</style>
